---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import Icon from '../components/Icon.astro';
import SupportingProject from '../components/SupportingProject.astro';
import ExternalLink from '../components/ExternalLink.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { homeFeaturedProjects, homeSupportingProjects } from '../data/projects';
import { experience } from '../data/experience';
const homePath = import.meta.env.BASE_URL;
const resumeHref = `${homePath}resume/Phillipe_Augusto_Resume.pdf`;
---
<BaseLayout title="Phillipe Augusto — Game Engineer" description="Game Engineer building gameplay systems, architecture, and tools across commercial games, live interactive products, and independent projects.">
  <section class="home-hero content-width nav-anchor-target" id="top" data-nav-section="home" aria-labelledby="hero-title">
    <h1 id="hero-title">Game Engineer</h1>
    <p class="hero-statement">I build gameplay systems, architecture, and tools that turn game ideas into responsive, polished, memorable player experiences.</p>
    <p class="hero-experience">10+ years in software engineering, including 8+ years with Unity &amp; C# across commercial games, live interactive products, and independent projects.</p>
    <nav class="hero-social" aria-label="Resume and profiles">
      <a class="hero-action hero-action--resume" href={resumeHref} target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)"><Icon name="resume" size={19} /><span>Resume</span></a>
      <a class="hero-action" href="https://www.linkedin.com/in/phillipe-augusto/" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/linkedin.svg`} alt="" width="20" height="20" /><span>LinkedIn</span></a>
      <a class="hero-action" href="https://github.com/phillipeaam" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/github.svg`} alt="" width="20" height="20" /><span>GitHub</span></a>
      <a class="hero-action" href="https://phillipeaam.itch.io/" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/itchio.svg`} alt="" width="20" height="20" /><span>itch.io</span></a>
      <a class="hero-action" href="https://www.youtube.com/@phillipeaam" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/youtube.svg`} alt="" width="20" height="20" /><span>YouTube</span></a>
    </nav>
  </section>

  <section class="section-block content-width" data-nav-section="work" aria-labelledby="featured-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="work"><div><p class="eyebrow">WORK, IN DEPTH</p><h2 id="featured-title">Selected work</h2></div><p><span class="section-support-line">Commercial gameplay, independent combat systems, and</span> <span class="section-support-line">production Unity engineering.</span></p></header>
    <div class="featured-list">{homeFeaturedProjects.map((project, index) => <FeaturedProject project={project} reverse={index % 2 === 1} />)}</div>
  </section>

  <section class="section-block content-width more-projects" data-nav-section="projects" aria-labelledby="projects-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="projects">
      <span class="nav-anchor-alias" id="other-work" aria-hidden="true"></span>
      <div><p class="eyebrow">BREADTH, AT A GLANCE</p><h2 id="projects-title">More Projects</h2></div><p><span class="section-support-line">Professional products, independent games, and technical</span>{' '}<span class="section-support-line">work beyond the selected case studies.</span></p>
    </header>
    <div class="more-projects__utility-row">
      <p class="more-projects__guidance">
        <span class="more-projects__guidance--hover">Hover to preview where available <span aria-hidden="true">·</span> Click a project to view details</span>
        <span class="more-projects__guidance--touch">Tap a project to view details</span>
      </p>
      <a class="section-footer-action" href={`${homePath}projects/`}><span class="section-footer-action__label">See all projects</span><span class="section-footer-action__icon" aria-hidden="true">→</span></a>
    </div>
    <div class="supporting-grid">
      {homeSupportingProjects.map((project) => <SupportingProject project={project} simple />)}
    </div>
  </section>

  <TestimonialsSection />

  <section class="section-block content-width human-section" data-nav-section="about" aria-labelledby="about-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="about">
      <span class="nav-anchor-alias" id="about-phillipe" aria-hidden="true"></span>
      <div><p class="eyebrow">A LITTLE ABOUT HOW I WORK</p><h2 id="about-title">About Phillipe</h2></div><p>The thinking behind the systems.</p>
    </header>
    <div class="human-profile">
      <figure class="profile-portrait"><img src="/images/identity/phillipe-augusto-profile.jpg" alt="Phillipe Augusto, Game Engineer" width="640" height="640" loading="lazy" decoding="async" /></figure>
      <div class="profile-content">
        <div class="profile-copy">
          <p>I like to know why a mechanic produced a result before adding another layer around it. I make its inputs and state visible, then look at where assumptions break—an unreachable grid destination or a partial recognition result.</p>
          <p>Once I can inspect that behavior on its own, I connect it back to the full player flow. That keeps iteration deliberate: I can explain what changed in the system and what the player will see, without adding abstraction for its own sake.</p>
        </div>
        <aside class="care-note" aria-labelledby="care-title">
          <p class="eyebrow" id="care-title">WHAT I CARE ABOUT</p>
          <ul>
            <li>Shared systems that leave room for distinct mechanics.</li>
            <li>Feedback that makes outcomes legible.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-block content-width experience-preview" data-nav-section="experience" aria-labelledby="experience-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="experience"><div><p class="eyebrow">CAREER, IN PRACTICE</p><h2 id="experience-title">Experience</h2></div><p><span class="section-support-line">Unity product engineering, commercial game development,</span> <span class="section-support-line">and earlier mobile software work.</span></p></header>
    <div class="experience-list">{experience.map((item) => <ExperienceEntry item={item} />)}</div>
    <div class="section-footer experience-provenance"><ExternalLink class="section-footer-action" href="https://www.linkedin.com/in/phillipe-augusto/details/experience/" ariaLabel="See all experience on LinkedIn (opens in a new tab)" icon><span class="section-footer-action__label">See all experience on LinkedIn</span></ExternalLink></div>
  </section>

</BaseLayout>
