---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import Icon from '../components/Icon.astro';
import SupportingProject from '../components/SupportingProject.astro';
import { featuredProjects, otherWork } from '../data/projects';
import { experience } from '../data/experience';
---
<BaseLayout title="Phillipe Augusto — Gameplay Engineer | Unity & C#" description="Gameplay engineering work by Phillipe Augusto: commercial Unity games, player-facing systems, and an independent tactical RPG prototype.">
  <section class="home-hero content-width" aria-labelledby="hero-title">
    <h1 id="hero-title">Gameplay Engineer <span>— Unity &amp; C#</span></h1>
    <p class="hero-statement">I build gameplay systems, architecture, and tools that turn game ideas into polished, memorable experiences.</p>
    <p class="hero-experience">8+ years in software development across commercial Unity games, live interactive products, and independent projects.</p>
    <nav class="hero-social" aria-label="Profiles">
      <a href="https://github.com/phillipeaam"><img src="/icons/github.svg" alt="" width="20" height="20" /><span>GitHub</span></a>
      <a href="https://www.linkedin.com/in/phillipe-augusto/"><img src="/icons/linkedin.svg" alt="" width="20" height="20" /><span>LinkedIn</span></a>
      <a href="https://phillipeaam.itch.io/"><img src="/icons/itchio.svg" alt="" width="20" height="20" /><span>itch.io</span></a>
      <a href="https://www.youtube.com/@phillipeaam"><img src="/icons/youtube.svg" alt="" width="20" height="20" /><span>YouTube</span></a>
    </nav>
    <div class="hero-system-mark" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
  </section>

  <section class="section-block content-width" id="work" aria-labelledby="featured-title">
    <header class="section-heading"><div><p class="eyebrow">SELECTED PROJECTS <span class="heading-count">/ 04</span></p><h2 id="featured-title">Selected work</h2></div><p>Commercial gameplay, independent combat systems, and production Unity engineering.</p></header>
    <div class="featured-list">{featuredProjects.map((project, index) => <FeaturedProject project={project} index={index + 1} reverse={index % 2 === 1} />)}</div>
  </section>

  <section class="section-block content-width human-section" id="about-phillipe" aria-labelledby="about-title">
    <header class="section-heading"><div><p class="eyebrow">A LITTLE ABOUT HOW I WORK</p><h2 id="about-title">About Phillipe</h2></div><p>The thinking behind the systems.</p></header>
    <div class="human-profile">
      <figure class="profile-portrait"><img src="/images/phillipe-augusto-profile.jpg" alt="Phillipe Augusto, Gameplay Engineer" width="640" height="640" loading="lazy" decoding="async" /></figure>
      <div class="profile-content">
        <div class="profile-copy">
          <p>I’m interested in the systems behind responsive mechanics and meaningful player feedback.</p>
          <p>I enjoy shaping gameplay architecture and tools that help teams iterate, keep code understandable, and carry features from implementation toward production. The details players may never notice still matter when they change how an experience feels.</p>
        </div>
        <aside class="care-note" aria-labelledby="care-title">
          <p class="eyebrow" id="care-title">WHAT I CARE ABOUT</p>
          <ul>
            <li>Gameplay that feels deliberate.</li>
            <li>Systems that stay understandable as they grow.</li>
            <li>Engineering choices players can feel, even when they never see them.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-block content-width recommendations-section" id="recommendations" aria-labelledby="recommendations-title">
    <header class="section-heading"><div><p class="eyebrow">COLLABORATION, IN THEIR WORDS</p><h2 id="recommendations-title">What teammates say</h2></div><a href="https://www.linkedin.com/in/phillipe-augusto/details/recommendations/">All LinkedIn recommendations <Icon name="external" size={15} /></a></header>
    <div class="recommendation-list" role="region" aria-label="LinkedIn recommendations. On small screens, scroll horizontally to read each recommendation." tabindex="0">
      <figure class="recommendation-card">
        <blockquote>“His care for detail, thorough support and feedbacks certainly inspired me to be a better engineer.”</blockquote>
        <figcaption><span class="recommendation-name">João Borges</span><span>Senior Software Engineer · Ello teammate</span><a href="https://www.linkedin.com/in/thatjoaoguy/">View on LinkedIn <Icon name="external" size={14} /></a></figcaption>
      </figure>
      <figure class="recommendation-card">
        <blockquote>“Phillipe (a.k.a. the master) did an exceptional job on all Alfa e Beto Institute products.”</blockquote>
        <figcaption><span class="recommendation-name">Douglas Otoni</span><span>Tech Lead / Full-stack Programmer, Grupo Paranaíba · former manager</span><a href="https://www.linkedin.com/in/douglasotoni/">View on LinkedIn <Icon name="external" size={14} /></a></figcaption>
      </figure>
      <figure class="recommendation-card">
        <blockquote>“I am proof of his skills with Unity Game Engine, Native Android and Database development.”</blockquote>
        <figcaption><span class="recommendation-name">Marllon Vilano</span><span>Staff / Lead Unity Engineer · teammate</span><a href="https://www.linkedin.com/in/sandolkakos/">View on LinkedIn <Icon name="external" size={14} /></a></figcaption>
      </figure>
    </div>
  </section>

  <section class="section-block content-width experience-preview" id="experience" aria-labelledby="experience-title">
    <header class="section-heading"><div><p class="eyebrow">PROFESSIONAL HISTORY <span class="heading-count">/ 03</span></p><h2 id="experience-title">Experience</h2></div><p>Unity product engineering, commercial game development, and earlier mobile software work.</p></header>
    <div class="experience-list">{experience.map((item, index) => <ExperienceEntry item={item} index={index + 1} />)}</div>
  </section>

  <section class="section-block content-width other-work" id="other-work" aria-labelledby="other-work-title">
    <header class="section-heading"><div><p class="eyebrow">SUPPORTING PROJECTS <span class="heading-count">/ {String(otherWork.length).padStart(2, '0')}</span></p><h2 id="other-work-title">Other Work</h2></div><p>Professional products, independent games, and technical work beyond the selected case studies.</p></header>
    <div class="supporting-grid">
      {otherWork.map((item) => <SupportingProject {...item} showMeta={false} showContext={false} />)}
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="content-width contact-inner"><div class="contact-heading"><p class="eyebrow">LET’S CONNECT</p><h2 id="contact-title">Looking for a Gameplay Engineer?<br /><span>Let’s talk.</span></h2><p>Unity gameplay systems, production engineering, and independent combat prototyping.</p></div><div class="contact-actions"><a class="contact-primary" href="mailto:phillipe.a.a.mendonca@gmail.com"><Icon name="mail" size={19} /> Email Phillipe <Icon name="arrow" size={19} /></a><a class="contact-secondary" href="https://www.linkedin.com/in/phillipe-augusto/"><span class="contact-linkedin-label"><img src="/icons/linkedin.svg" alt="" width="18" height="18" />Connect on LinkedIn</span><Icon name="external" size={17} /></a></div></div></section>
</BaseLayout>
