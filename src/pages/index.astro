---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import Icon from '../components/Icon.astro';
import SupportingProject from '../components/SupportingProject.astro';
import ExternalLink from '../components/ExternalLink.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { featuredProjects, otherWork } from '../data/projects';
import { experience } from '../data/experience';
const homePath = import.meta.env.BASE_URL;
const resumeHref = `${homePath}resume/Phillipe_Augusto_Resume.pdf`;
---
<BaseLayout title="Phillipe Augusto — Game Engineer" description="Game Engineer building gameplay systems, architecture, and tools across commercial games, live interactive products, and independent projects.">
  <section class="home-hero content-width nav-anchor-target" id="top" data-nav-section="home" aria-labelledby="hero-title">
    <h1 id="hero-title">Game Engineer</h1>
    <p class="hero-statement">I build gameplay systems, architecture, and tools that turn game ideas into responsive, polished, memorable player experiences.</p>
    <p class="hero-experience">10+ years in software engineering, including 8+ years with Unity &amp; C# across commercial games, live interactive products, and independent projects.</p>
    <nav class="hero-social" aria-label="Resume and profiles">
      <a class="hero-action hero-action--resume" href={resumeHref} target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)"><Icon name="resume" size={19} /><span>Resume</span></a>
      <a class="hero-action" href="https://www.linkedin.com/in/phillipe-augusto/" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/linkedin.svg`} alt="" width="20" height="20" /><span>LinkedIn</span></a>
      <a class="hero-action" href="https://github.com/phillipeaam" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/github.svg`} alt="" width="20" height="20" /><span>GitHub</span></a>
      <a class="hero-action" href="https://phillipeaam.itch.io/" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/itchio.svg`} alt="" width="20" height="20" /><span>itch.io</span></a>
      <a class="hero-action" href="https://www.youtube.com/@phillipeaam" target="_blank" rel="noopener noreferrer"><img src={`${homePath}icons/social/youtube.svg`} alt="" width="20" height="20" /><span>YouTube</span></a>
    </nav>
  </section>

  <section class="section-block content-width" data-nav-section="work" aria-labelledby="featured-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="work"><div><p class="eyebrow">SELECTED PROJECTS <span class="heading-count">/ 04</span></p><h2 id="featured-title">Selected work</h2></div><p>Commercial gameplay, independent combat systems, and production Unity engineering.</p></header>
    <div class="featured-list">{featuredProjects.map((project, index) => <FeaturedProject project={project} index={index + 1} reverse={index % 2 === 1} />)}</div>
  </section>

  <section class="section-block content-width more-projects" data-nav-section="projects" aria-labelledby="projects-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="projects">
      <span class="nav-anchor-alias" id="other-work" aria-hidden="true"></span>
      <div><p class="eyebrow">SUPPORTING PROJECTS <span class="heading-count">/ {String(otherWork.length).padStart(2, '0')}</span></p><h2 id="projects-title">More Projects</h2></div><p>Professional products, independent games, and technical work beyond the selected case studies.</p>
    </header>
    <div class="supporting-grid">
      {otherWork.map((item) => <SupportingProject {...item} showMeta={false} showContext={false} />)}
    </div>
  </section>

  <TestimonialsSection />

  <section class="section-block content-width human-section" data-nav-section="about" aria-labelledby="about-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="about">
      <span class="nav-anchor-alias" id="about-phillipe" aria-hidden="true"></span>
      <div><p class="eyebrow">A LITTLE ABOUT HOW I WORK</p><h2 id="about-title">About Phillipe</h2></div><p>The thinking behind the systems.</p>
    </header>
    <div class="human-profile">
      <figure class="profile-portrait"><img src="/images/phillipe-augusto-profile.jpg" alt="Phillipe Augusto, Game Engineer" width="640" height="640" loading="lazy" decoding="async" /></figure>
      <div class="profile-content">
        <div class="profile-copy">
          <p>I like to know why a mechanic produced a result before adding another layer around it. I make its inputs and state visible, then look at where assumptions break—an unreachable grid destination or a partial recognition result.</p>
          <p>Once I can inspect that behavior on its own, I connect it back to the full player flow. That keeps iteration deliberate: I can explain what changed in the system and what the player will see, without adding abstraction for its own sake.</p>
        </div>
        <aside class="care-note" aria-labelledby="care-title">
          <p class="eyebrow" id="care-title">WHAT I CARE ABOUT</p>
          <ul>
            <li>Shared systems that leave room for distinct mechanics.</li>
            <li>Feedback that makes outcomes legible.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-block content-width experience-preview" data-nav-section="experience" aria-labelledby="experience-title">
    <header class="section-heading section-heading--major nav-anchor-target" id="experience"><div><p class="eyebrow">PROFESSIONAL HISTORY <span class="heading-count">/ 03</span></p><h2 id="experience-title">Experience</h2></div><p>Unity product engineering, commercial game development, and earlier mobile software work.</p></header>
    <div class="experience-list">{experience.map((item) => <ExperienceEntry item={item} />)}</div>
    <div class="experience-provenance"><ExternalLink class="experience-linkedin" href="https://www.linkedin.com/in/phillipe-augusto/details/experience/" ariaLabel="See all experience on LinkedIn (opens in a new tab)" icon>See all experience on LinkedIn</ExternalLink></div>
  </section>

  <section class="contact-section" data-nav-section="contact" aria-labelledby="contact-title"><div class="content-width contact-inner"><div class="contact-heading nav-anchor-target" id="contact"><p class="eyebrow">GET IN TOUCH</p><h2 id="contact-title">If the work resonates,<br /><span>let’s talk.</span></h2><p>I’m open to opportunities, collaborations, and conversations across game development — whether that means building something together, exchanging ideas, or making useful introductions when I can.</p></div><div class="contact-actions"><ExternalLink class="hero-action contact-action contact-action--primary" href="https://www.linkedin.com/in/phillipe-augusto/" ariaLabel="LinkedIn profile (opens in a new tab)"><img src={`${homePath}icons/social/linkedin.svg`} alt="" width="20" height="20" /><span>LinkedIn</span><Icon name="external" size={16} /></ExternalLink><a class="hero-action contact-action contact-action--secondary" href="mailto:phillipe.a.a.mendonca@gmail.com"><Icon name="mail" size={19} /><span>Email me</span><Icon name="arrow" size={19} /></a><button class="hero-action contact-action contact-action--copy" type="button" data-copy-email="phillipe.a.a.mendonca@gmail.com" aria-label="Copy phillipe.a.a.mendonca@gmail.com to clipboard"><span class="contact-copy-address">phillipe.a.a.mendonca@gmail.com</span><span class="contact-copy-feedback" aria-hidden="true"><span data-copy-icon><Icon name="copy" size={18} /></span><span data-copied-label hidden>Copied</span></span></button><span class="contact-copy-status" id="contact-copy-status" role="status" aria-live="polite"></span></div></div></section>
  <script>
    const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    const copyEmailStatus = document.querySelector<HTMLElement>('#contact-copy-status');
    const copyEmailIcon = copyEmailButton?.querySelector<HTMLElement>('[data-copy-icon]');
    const copyEmailCopiedLabel = copyEmailButton?.querySelector<HTMLElement>('[data-copied-label]');
    let copyEmailResetTimer: number | undefined;

    copyEmailButton?.addEventListener('click', async () => {
      const email = copyEmailButton.dataset.copyEmail;
      if (!email || !copyEmailIcon || !copyEmailCopiedLabel || !copyEmailStatus) return;

      window.clearTimeout(copyEmailResetTimer);
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
        await navigator.clipboard.writeText(email);
        copyEmailButton.dataset.state = 'copied';
        copyEmailIcon.hidden = true;
        copyEmailCopiedLabel.hidden = false;
        copyEmailStatus.textContent = 'Email copied to clipboard.';
        copyEmailStatus.classList.remove('is-visible');
      } catch {
        copyEmailButton.dataset.state = 'failed';
        copyEmailIcon.hidden = true;
        copyEmailCopiedLabel.hidden = false;
        copyEmailCopiedLabel.textContent = 'Copy failed';
        copyEmailStatus.textContent = 'Copy failed — select the email address manually.';
        copyEmailStatus.classList.add('is-visible');
      }

      copyEmailResetTimer = window.setTimeout(() => {
        delete copyEmailButton.dataset.state;
        copyEmailIcon.hidden = false;
        copyEmailCopiedLabel.hidden = true;
        copyEmailCopiedLabel.textContent = 'Copied';
        copyEmailStatus.textContent = '';
        copyEmailStatus.classList.remove('is-visible');
      }, 1800);
    });
  </script>
</BaseLayout>
