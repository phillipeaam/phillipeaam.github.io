---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRecord from '../../components/ProjectRecord.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getTechnologyFacetTags, projectInventoryGroups } from '../../data/projects';
import Icon from '../../components/Icon.astro';

const homePath = import.meta.env.BASE_URL;
// Preserve the archive's existing editorial group order while presenting one list.
const orderedProjects = projectInventoryGroups.flatMap((group) => group.projects);
const contexts = [...new Set(orderedProjects.flatMap(({ workContext }) => workContext ? [workContext] : []))];
const technologies = [...new Set(orderedProjects.flatMap(({ technologies: values }) => getTechnologyFacetTags(values)))].sort((a, b) => a.localeCompare(b));
const contextLabel = (context: string) => context === 'professional' ? 'Professional' : context === 'independent' ? 'Independent' : 'Study';
---
<BaseLayout title="Projects — Phillipe Augusto" description="Explore Phillipe Augusto’s projects across professional, independent, and study contexts." contextualNavigation={true}>
  <section class="archive-content content-width" data-project-catalog data-total={orderedProjects.length} aria-labelledby="projects-heading">
    <SectionHeading placementClass="archive-intro" eyebrow="BEYOND THE HIGHLIGHTS" title="All Projects" titleId="projects-heading" titleLevel="h1" support="Browse the complete portfolio by context or technology." />

    <section class="catalog-controls" aria-label="Search and filter projects" hidden data-catalog-controls>
      <div class="catalog-controls__search">
        <label for="project-search">Search for</label>
        <input id="project-search" type="search" autocomplete="off" placeholder="Name, product, contribution…" aria-describedby="project-search-help" />
        <p id="project-search-help">Search project names and public details.</p>
      </div>
      <div class="catalog-controls__facet">
        <span class="catalog-controls__label" id="context-facet-label">Context</span>
        <details class="catalog-facet" name="project-catalog-facets" data-facet="context">
          <summary aria-labelledby="context-facet-label context-facet-selection"><span class="catalog-facet__selection" id="context-facet-selection" data-selection-label>All</span><Icon name="plus" size={16} class="catalog-facet__icon catalog-facet__icon--closed" /><Icon name="minus" size={16} class="catalog-facet__icon catalog-facet__icon--open" /></summary>
          <div class="catalog-facet__panel">
            <label class="sr-only" for="context-options-search">Search Context options</label>
            <input class="catalog-facet__search" id="context-options-search" type="search" autocomplete="off" placeholder="Search options…" data-option-search="context" />
            <div class="catalog-facet__options" role="group" aria-label="Context options">
              {contexts.map((context) => <label><input type="checkbox" name="context" value={context} aria-label={`${contextLabel(context)} context`} /> {contextLabel(context)}</label>)}
            </div>
            <p class="catalog-facet__empty" data-options-empty role="status" aria-live="polite" hidden>No Context options match.</p>
          </div>
        </details>
      </div>
      <div class="catalog-controls__facet">
        <span class="catalog-controls__label" id="technology-facet-label">Technology</span>
        <details class="catalog-facet" name="project-catalog-facets" data-facet="technology">
          <summary aria-labelledby="technology-facet-label technology-facet-selection"><span class="catalog-facet__selection" id="technology-facet-selection" data-selection-label>All</span><Icon name="plus" size={16} class="catalog-facet__icon catalog-facet__icon--closed" /><Icon name="minus" size={16} class="catalog-facet__icon catalog-facet__icon--open" /></summary>
          <div class="catalog-facet__panel">
            <label class="sr-only" for="technology-options-search">Search Technology options</label>
            <input class="catalog-facet__search" id="technology-options-search" type="search" autocomplete="off" placeholder="Search options…" data-option-search="technology" />
            <div class="catalog-facet__options catalog-facet__options--technology" role="group" aria-label="Technology options">
              {technologies.map((technology, index) => <label><input type="checkbox" name="technology" value={technology} id={`technology-${index}`} aria-label={`${technology} technology`} /> {technology}</label>)}
            </div>
            <p class="catalog-facet__empty" data-options-empty role="status" aria-live="polite" hidden>No Technology options match.</p>
          </div>
        </details>
      </div>
      <button class="catalog-clear" type="button" data-clear-filters>Clear all filters</button>
    </section>

    <p class="catalog-count" data-catalog-count aria-live="polite">Showing {orderedProjects.length} of {orderedProjects.length} projects</p>
    <p class="catalog-empty" data-catalog-empty hidden>No projects match these filters.</p>
    <ol class="archive-record-list" data-catalog-list>
      {orderedProjects.map((project) => <ProjectRecord project={project} homePath={homePath} />)}
    </ol>
  </section>
</BaseLayout>

<script>
  const catalog = document.querySelector<HTMLElement>('[data-project-catalog]');
  const controls = catalog?.querySelector<HTMLElement>('[data-catalog-controls]');
  const list = catalog?.querySelector<HTMLOListElement>('[data-catalog-list]');
  const search = catalog?.querySelector<HTMLInputElement>('#project-search');
  const count = catalog?.querySelector<HTMLElement>('[data-catalog-count]');
  const empty = catalog?.querySelector<HTMLElement>('[data-catalog-empty]');
  const records = Array.from(catalog?.querySelectorAll<HTMLElement>('[data-project-record]') ?? []);
  const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLocaleLowerCase();
  const checkboxes = Array.from(catalog?.querySelectorAll<HTMLInputElement>('.catalog-controls input[type="checkbox"]') ?? []);
  const optionSearches = Array.from(catalog?.querySelectorAll<HTMLInputElement>('[data-option-search]') ?? []);
  const facets = Array.from(catalog?.querySelectorAll<HTMLElement>('[data-facet]') ?? []);
  facets.forEach((facet) => facet.addEventListener('toggle', () => {
    if (!facet.hasAttribute('open')) return;
    const optionSearch = facet.querySelector<HTMLInputElement>('[data-option-search]');
    requestAnimationFrame(() => {
      optionSearch?.focus();
      optionSearch?.select();
    });
    facets.forEach((otherFacet) => {
      if (otherFacet !== facet && otherFacet.hasAttribute('open')) otherFacet.removeAttribute('open');
    });
  }));
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    facets.forEach((facet) => {
      if (facet.hasAttribute('open') && !facet.contains(target)) facet.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openFacet = facets.find((facet) => facet.hasAttribute('open'));
    if (!openFacet) return;
    const summary = openFacet.querySelector<HTMLElement>('summary');
    openFacet.removeAttribute('open');
    summary?.focus();
  });
  const refreshFacetOptions = () => {
    facets.forEach((facet) => {
      const facetName = facet.dataset.facet ?? '';
      const optionQuery = normalize(facet.querySelector<HTMLInputElement>('[data-option-search]')?.value ?? '');
      const labels = Array.from(facet.querySelectorAll<HTMLLabelElement>('.catalog-facet__options > label'));
      let matches = 0;
      labels.forEach((label) => {
        const checkbox = label.querySelector<HTMLInputElement>('input[type="checkbox"]');
        const matchesQuery = !optionQuery || normalize(label.textContent ?? '').includes(optionQuery);
        if (matchesQuery) matches += 1;
        // Keep selected values visible even when they do not match the local option query.
        label.hidden = !matchesQuery && !checkbox?.checked;
      });
      const noOptions = facet.querySelector<HTMLElement>('[data-options-empty]');
      if (noOptions) noOptions.hidden = matches > 0;
      const selected = checkboxes.filter((checkbox) => checkbox.name === facetName && checkbox.checked).length;
      const selectionLabel = facet.querySelector<HTMLElement>('[data-selection-label]');
      if (selectionLabel) selectionLabel.textContent = selected ? `${selected} selected` : 'All';
    });
  };
  const reset = (moveFocus = true) => {
    if (search) search.value = '';
    checkboxes.forEach((checkbox) => { checkbox.checked = false; });
    optionSearches.forEach((input) => { input.value = ''; });
    refreshFacetOptions();
    update();
    if (moveFocus) search?.focus();
  };
  const update = () => {
    if (!catalog || !count || !empty || !list) return;
    const query = normalize(search?.value ?? '');
    const selectedContexts = checkboxes.filter((input) => input.name === 'context' && input.checked).map(({ value }) => value);
    const selectedTechnologies = checkboxes.filter((input) => input.name === 'technology' && input.checked).map(({ value }) => value);
    let visible = 0;
    records.forEach((record) => {
      const textMatches = !query || normalize(record.textContent ?? '').includes(query);
      const contextMatches = selectedContexts.length === 0 || selectedContexts.includes(record.dataset.context ?? '');
      const recordTechnologies = (record.dataset.technologies ?? '').split('|').filter(Boolean);
      const technologyMatches = selectedTechnologies.length === 0 || selectedTechnologies.some((technology) => recordTechnologies.includes(technology));
      const matches = textMatches && contextMatches && technologyMatches;
      record.hidden = !matches;
      if (!matches) {
        record.querySelectorAll('details[open]').forEach((details) => { details.removeAttribute('open'); });
      } else visible += 1;
    });
    count.textContent = `Showing ${visible} of ${records.length} projects`;
    empty.hidden = visible !== 0;
    list.hidden = visible === 0;
  };
  controls?.removeAttribute('hidden');
  search?.addEventListener('input', update);
  optionSearches.forEach((input) => input.addEventListener('input', refreshFacetOptions));
  checkboxes.forEach((checkbox) => checkbox.addEventListener('change', () => { refreshFacetOptions(); update(); }));
  catalog?.querySelectorAll<HTMLButtonElement>('[data-clear-filters]').forEach((button) => button.addEventListener('click', () => reset()));
  update();
  refreshFacetOptions();

  const revealHashTarget = () => {
    if (!window.location.hash) return;
    let id = '';
    try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id)?.closest<HTMLElement>('[data-project-record]');
    if (!target || !target.hidden) return;
    reset(false);
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  };
  revealHashTarget();
  window.addEventListener('hashchange', revealHashTarget);
</script>
