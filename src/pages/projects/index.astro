---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRecord from '../../components/ProjectRecord.astro';
import { projectInventoryGroups } from '../../data/projects';

const homePath = import.meta.env.BASE_URL;
const supportSplitAfterWord: Record<string, number> = {
  'professional-game': 6,
  'professional-product': 5,
  'independent-game': 6,
  'study-archive': 7,
};
const supportLines = (id: string, copy: string) => {
  const words = copy.split(' ');
  const splitAt = supportSplitAfterWord[id] ?? words.length;
  return [words.slice(0, splitAt).join(' '), words.slice(splitAt).join(' ')];
};
---
<BaseLayout title="Projects — Phillipe Augusto" description="Explore Phillipe Augusto’s professional Unity games, interactive products, independent projects, and technical studies." contextualNavigation={true}>
  <h1 class="sr-only">All Projects</h1>
  <div class="archive-content content-width">
    {projectInventoryGroups.map((group) => group.projects.length > 0 && <section class="archive-group" id={group.id} aria-labelledby={`archive-group-${group.id}`}>
      <header class="section-heading section-heading--major" aria-labelledby={`archive-group-${group.id}`}>
        <div><h2 id={`archive-group-${group.id}`}>{group.title}</h2></div>
        <p><span class="section-support-line">{supportLines(group.id, group.intro)[0]}</span>{' '}<span class="section-support-line">{supportLines(group.id, group.intro)[1]}</span></p>
      </header>
      <ol class="archive-record-list">
        {group.projects.map((project) => <ProjectRecord project={project} homePath={homePath} />)}
      </ol>
    </section>)}
  </div>

</BaseLayout>
