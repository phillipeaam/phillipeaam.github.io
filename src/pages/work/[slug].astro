---
import { caseStudyPath } from '../../data/caseStudyRoutes';
import { hasPublishableCaseStudy, isPortfolioIncluded, projectRecords } from '../../data/projects';

export function getStaticPaths() {
  return projectRecords.flatMap((project) => {
    if (!isPortfolioIncluded(project) || !hasPublishableCaseStudy(project)) return [];
    return { params: { slug: project.caseStudy.slug }, props: { project } };
  });
}

const { project } = Astro.props;
const destination = caseStudyPath(project.caseStudy.slug, import.meta.env.BASE_URL);
const canonicalUrl = new URL(destination, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.name} — Case study moved</title>
    <link rel="canonical" href={canonicalUrl} />
    <script is:inline data-destination={destination}>
      const target = document.currentScript.dataset.destination;
      window.location.replace(target + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${destination}`} /></noscript>
  </head>
  <body>
    <main>
      <h1>This case study has moved</h1>
      <p><a href={destination}>View {project.name} case study</a></p>
    </main>
  </body>
</html>
