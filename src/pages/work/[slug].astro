---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHero from '../../components/CaseHero.astro';
import EngineeringStory from '../../components/EngineeringStory.astro';
import NextProject from '../../components/NextProject.astro';
import { caseStudies } from '../../data/cases';

export function getStaticPaths() {
  return caseStudies.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---
<BaseLayout title={`${item.project.name} — Gameplay Engineering Case Study | Phillipe Augusto`} description={item.metaDescription} caseNavigation={true}>
  <div class="case-page content-width" data-kind={item.project.kind}>
    <CaseHero project={item.project} media={item.media} summary={item.heroSummary} statement={item.heroStatement} links={item.developmentEras ? item.evidenceLinks : undefined} />
    <section class="case-glance" aria-labelledby="glance-title"><h2 id="glance-title" class="eyebrow">AT A GLANCE</h2><dl>{item.glance.map((fact: { label: string; value: string }) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl></section>
    <section class="case-context"><div><p class="eyebrow">{item.scopeLabel}</p><h2>Project context</h2><p>{item.scope}</p></div><div><p class="eyebrow">{item.ownershipLabel}</p><h2>Ownership</h2><p>{item.ownership}</p></div></section>
    <section class="case-selected-stories" aria-labelledby="selected-stories-title"><h2 id="selected-stories-title">Selected Engineering Stories</h2><p>{item.selectedStories}</p></section>
    <div class="case-stories">{item.stories.map((story: any, index: number) => <EngineeringStory story={story} index={index + 1} kind={item.project.kind} />)}</div>
    {item.supporting && <section class="case-supporting" aria-labelledby="case-supporting-title"><p class="eyebrow">SUPPORTING ENGINEERING WORK</p><h2 id="case-supporting-title">{item.supporting.title}</h2><p>{item.supporting.text}</p>{item.supporting.visual === 'weapon-offsets' && <div class="weapon-rule" aria-label="Weapon area rule: copy configured offsets, rotate for requested direction, then translate to a grid position"><span>Configured offsets <small>with multipliers</small></span><i aria-hidden="true">→</i><span>Copy + rotate <small>requested N / E / S / W</small></span><i aria-hidden="true">→</i><span>Translate to origin <small>affected grid cells</small></span></div>}</section>}
    {item.developmentEras && <section class="case-eras" aria-labelledby="case-eras-title"><p class="eyebrow">TIMELINE &amp; PUBLIC BUILD</p><h2 id="case-eras-title">Development Eras</h2><div>{item.developmentEras.map((era: { label: string; text: string }) => <article><h3>{era.label}</h3><p>{era.text}</p></article>)}</div></section>}
    <section class="quiet-section"><p class="eyebrow">REFLECTION</p><h2>What I would carry forward</h2><p>{item.reflection}</p></section>
    {item.developmentEras && <nav class="case-outbound" aria-label="Wallace’s Quest public links"><p class="eyebrow">EXPLORE THE PROJECT</p><div>{item.evidenceLinks.map((link: { label: string; href: string }) => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div><p>These links show the historical 2020 game. The 2021 module is documented by source history, not by the public build.</p></nav>}
    <NextProject project={caseStudies.find((candidate) => candidate.slug === item.nextSlug)?.project ?? caseStudies[0].project} />
  </div>
</BaseLayout>

<style>
  .case-page[data-kind='ello'] :global(.case-hero .media-figure) { max-width: 860px; }
  .case-page[data-kind='ello'] :global(.case-hero .media-caption::before) { display: none; }
  .case-selected-stories { max-width: 800px; padding-top: var(--s-8); }
  .case-selected-stories h2 { margin: 0 0 12px; font-size: clamp(27px, 3.2vw, 34px); }
  .case-selected-stories p { max-width: 72ch; margin: 0; color: var(--secondary); font-size: 17px; line-height: 1.58; }
  .case-selected-stories + .case-stories :global(.narrative-story:first-child) { margin-top: var(--s-8); border-top: 1px solid var(--line); }
  .case-supporting { display: grid; grid-template-columns: minmax(0, .65fr) minmax(0, 1fr); gap: 8px 48px; padding: 48px 0; border-bottom: 1px solid var(--line); }
  .case-supporting .eyebrow { grid-column: 1 / -1; margin-bottom: 0; color: var(--project-accent); }
  .case-supporting h2 { max-width: 18ch; margin: 0; font-size: clamp(25px, 2.8vw, 34px); }
  .case-supporting > p:not(.eyebrow) { max-width: 68ch; margin: 0; color: var(--secondary); }
  .weapon-rule { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: stretch; gap: 8px; margin-top: 12px; }
  .weapon-rule span { display: grid; align-content: center; min-width: 190px; flex: 1; gap: 3px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 3px; background: var(--media); font-size: 14px; }
  .weapon-rule small { color: var(--secondary); font-size: 11px; }
  .weapon-rule i { align-self: center; color: var(--project-accent); font-size: 22px; font-style: normal; }
  .case-eras { padding: var(--s-16) 0; border-bottom: 1px solid var(--line); }
  .case-eras h2 { margin-bottom: 28px; font-size: clamp(27px, 3vw, 34px); }
  .case-eras > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .case-eras article { padding-top: 16px; border-top: 1px solid var(--line-strong); }
  .case-eras h3 { margin-bottom: 10px; font-size: 18px; }
  .case-eras article p { max-width: 45ch; margin: 0; color: var(--secondary); font-size: 14px; line-height: 1.6; }
  .case-outbound { padding: var(--s-12) 0; border-bottom: 1px solid var(--line); }
  .case-outbound > div { display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .case-outbound > p:last-child { max-width: 72ch; margin: 12px 0 0; color: var(--muted); font-size: 13px; }
  @media (max-width: 820px) { .case-supporting { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 36px 0; } .case-eras > div { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  @media (max-width: 620px) { .weapon-rule { display: grid; grid-template-columns: minmax(0, 1fr); } .weapon-rule i { justify-self: center; transform: rotate(90deg); line-height: 1; } }
</style>
