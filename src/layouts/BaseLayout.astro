---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const { title = 'Phillipe Augusto — Game Engineer', description = 'Game Engineer building gameplay systems, architecture, and tools across commercial games, live interactive products, and independent projects.', contextualNavigation = false, caseNavigation = false } = Astro.props;
const basePath = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-home-path={basePath}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111318" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:inline>
      html[data-page-loading="true"] body,
      html[data-restoring-home-scroll="true"] body { visibility: hidden; }
    </style>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.pageLoading = 'true';
        // Preserve layout while fonts settle, then reveal the complete page.
        const revealPage = () => { delete root.dataset.pageLoading; };
        const ready = document.readyState !== 'loading'
          ? Promise.resolve()
          : new Promise((resolve) => document.addEventListener('DOMContentLoaded', resolve, { once: true }));
        ready.then(() => document.fonts?.ready ?? Promise.resolve()).catch(() => {}).then(() => requestAnimationFrame(revealPage));
        setTimeout(revealPage, 4000);
        try {
          if (location.pathname === root.dataset.homePath && sessionStorage.getItem('portfolio-restore-home-scroll') === 'true') {
            root.dataset.restoringHomeScroll = 'true';
            // Fail open if loading is interrupted; never leave the page hidden.
            setTimeout(() => { delete root.dataset.restoringHomeScroll; }, 4000);
          }
        } catch { /* Storage unavailable: keep normal page rendering. */ }
      })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href={`${basePath}images/identity/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${basePath}images/identity/favicon-48.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${basePath}images/identity/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navigation contextual={contextualNavigation} caseNavigation={caseNavigation} />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline>
      (() => {
        const homeScrollKey = 'portfolio-home-scroll-y';
        const restoreHomeKey = 'portfolio-restore-home-scroll';
        const root = document.documentElement;
        const homePath = root.dataset.homePath ?? '/';
        const restoreScroll = (top) => {
          window.scrollTo({ top, left: 0, behavior: 'instant' });
        };

        let shouldRestoreHome = false;
        let savedScroll = Number.NaN;
        try {
          shouldRestoreHome = window.location.pathname === homePath && sessionStorage.getItem(restoreHomeKey) === 'true';
          if (shouldRestoreHome) savedScroll = Number(sessionStorage.getItem(homeScrollKey));
        } catch { /* Storage unavailable: keep normal page rendering. */ }

        if (shouldRestoreHome) {
          root.dataset.restoringHomeScroll = 'true';
          // Restore after layout and fonts settle; early scrolling can be shifted
          // by scroll anchoring and then saved as the next return position.
          const loaded = document.readyState !== 'loading'
            ? Promise.resolve()
            : new Promise((resolve) => document.addEventListener('DOMContentLoaded', resolve, { once: true }));
          const fontsReady = Promise.resolve(document.fonts?.ready).catch(() => undefined);
          Promise.race([Promise.all([loaded, fontsReady]), new Promise((resolve) => setTimeout(resolve, 3500))]).then(() => {
            requestAnimationFrame(() => {
              if (Number.isFinite(savedScroll)) restoreScroll(savedScroll);
              requestAnimationFrame(() => {
                try { sessionStorage.removeItem(restoreHomeKey); } catch { /* Storage unavailable. */ }
                delete root.dataset.restoringHomeScroll;
              });
            });
          });
          return;
        }

        if (window.location.pathname === `${homePath}projects/` && window.location.hash) {
          let targetId;
          try {
            targetId = decodeURIComponent(window.location.hash.slice(1));
          } catch {
            return;
          }
          const target = document.getElementById(targetId);
          if (!target) return;
          const scrollMarginTop = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
          restoreScroll(window.scrollY + target.getBoundingClientRect().top - scrollMarginTop);
        }
      })();
    </script>
  </body>
</html>
