---
import { caseStudyPath } from '../data/caseStudyRoutes';
import ExternalLink from './ExternalLink.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import ArchiveMedia from './ArchiveMedia.astro';
import MediaPoster from './MediaPoster.astro';
import Icon from './Icon.astro';
import { hasPublishableCaseStudy, isPortfolioIncluded, sortProjectActions, type ProjectRecord } from '../data/projects';

const { project, homePath = '/' } = Astro.props as { project: ProjectRecord; homePath?: string };
const titleId = `archive-title-${project.id}`;
const orderedActions = sortProjectActions(project.actions);
const caseHref = isPortfolioIncluded(project) && hasPublishableCaseStudy(project) ? caseStudyPath(project.caseStudy.slug, homePath) : undefined;
const [leadMedia, ...supportingMedia] = project.media ?? [];
const metadataLabels = ['Role', 'Period', 'Stack', 'Context'] as const;
const metadata = metadataLabels.flatMap((label) => {
  const value = label === 'Context' ? project.context : project.specs?.find((spec) => spec.label === label)?.value ?? (label === 'Period' ? project.period : undefined);
  return value ? [{ label, value }] : [];
});
---
<article aria-labelledby={titleId}>
  <div class="archive-record__rich-grid">
    <div class="archive-record__media-column">
      <div class="archive-record__media">
        {leadMedia
          ? leadMedia.previewSrc && leadMedia.type === 'image'
            ? <ProjectMediaPreview src={leadMedia.src} previewSrc={leadMedia.previewSrc} alt={leadMedia.alt} previewAlt={leadMedia.previewAlt} posterWidth={leadMedia.posterWidth} posterHeight={leadMedia.posterHeight} posterFit={leadMedia.posterFit} autoplayPreview={leadMedia.autoplayPreview} />
            : <ArchiveMedia media={leadMedia} projectName={project.name} />
          : <MediaPoster label={project.evidenceLabel ?? project.name} kind={project.kind ?? 'neutral'} caption={project.mediaCaption} />}
        {supportingMedia.length > 0 && <div class="archive-record__supporting-media">
          {supportingMedia.slice(0, 3).map((media) => <ArchiveMedia media={media} projectName={project.name} />)}
        </div>}
      </div>
      <p class="archive-record__overview">{project.summary}</p>
      {(caseHref || (isPortfolioIncluded(project) && orderedActions.length)) && <nav class="archive-record__actions" aria-label={`${project.name} links`}>
        {isPortfolioIncluded(project) && orderedActions.map((action) => <ExternalLink href={action.href} ariaLabel={`${action.label} for ${project.name} (opens in a new tab)`} icon>{action.label}</ExternalLink>)}
        {caseHref && <a class="archive-record__case-link" href={caseHref} aria-label={`View ${project.name} case study`}><span class="archive-record__case-link-label">View case study</span><Icon name="arrow-right" size={16} class="archive-record__case-link-arrow" /></a>}
      </nav>}
    </div>
    <div class="archive-record__details">
      <header class="archive-record__header">
        <div class="archive-record__identity">
          {project.projectsIndexTitleIcon && <img class="archive-record__title-icon" src={project.projectsIndexTitleIcon} alt="" width="52" height="52" loading="lazy" decoding="async" />}
          <h3 id={titleId}>{project.name}</h3>
        </div>
      </header>
      {metadata.length > 0 && <dl class="archive-record__specs">
        {metadata.map(({ label, value }) => <div>
          <dt>{label}</dt>
          <dd class:list={[label === 'Stack' && 'archive-record__stack-value']}>
            {label === 'Stack' ? value.split(' · ').map((item, index, items) => <Fragment><span class="archive-record__stack-item">{item}</span>{index < items.length - 1 && <span class="archive-record__stack-separator" aria-hidden="true">·</span>}</Fragment>) : value}
          </dd>
        </div>)}
      </dl>}
      <div class="archive-record__body">
        {project.contribution && <div class="archive-record__contribution archive-record__contribution--primary">
          <p class="archive-record__label">My contribution</p>
          <p>{project.contribution}</p>
        </div>}
        {project.engineeringFocus && <div class="archive-record__contribution archive-record__contribution--engineering">
          <p class="archive-record__label">Engineering focus</p>
          <p>{project.engineeringFocus}</p>
        </div>}
      </div>
    </div>
  </div>
</article>
