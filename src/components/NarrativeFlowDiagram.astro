---
import type { NarrativeDiagram } from '../data/projects';
import Icon from './Icon.astro';

const { diagram } = Astro.props as { diagram?: NarrativeDiagram };
---
{diagram && <figure class="narrative-flow" aria-label={diagram.title}>
  <figcaption class="narrative-flow__heading">
    <span class="eyebrow">SYSTEM MODEL</span>
    <strong>{diagram.title}</strong>
  </figcaption>
  <div class="narrative-flow__groups" style={`--flow-columns: ${diagram.groups.length}`}>
    {diagram.groups.map((group, groupIndex) => (
      <section class:list={['narrative-flow__group', `narrative-flow__group--${group.tone}`]} aria-label={group.label}>
        <h3>{group.label}</h3>
        <ol>
          {group.steps.map((step) => (
            <li>
              <div class="narrative-flow__node">
                <span>{step.label}</span>
                {step.detail && <small>{step.detail}</small>}
              </div>
              {step.next && <div class="narrative-flow__step-link"><Icon name="arrow-down" size={16} /><small>{step.next}</small></div>}
            </li>
          ))}
        </ol>
        {group.handoff && groupIndex < diagram.groups.length - 1 && <p class:list={['narrative-flow__handoff', group.handoffAsync && 'narrative-flow__handoff--async']}><Icon name="arrow-right" size={18} />{group.handoff}</p>}
      </section>
    ))}
  </div>
  {diagram.notes?.length && <div class="narrative-flow__notes">
    {diagram.notes.map((note) => <p><strong>{note.label}</strong><span>{note.text}</span></p>)}
  </div>}
  <p class="narrative-flow__caption">{diagram.caption}</p>
</figure>}

<style>
  .narrative-flow { margin: 0; padding: clamp(18px, 3vw, 32px); border: 1px solid color-mix(in srgb, var(--project-accent) 28%, var(--line)); border-radius: 4px; background: var(--media); }
  .narrative-flow__heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .narrative-flow__heading .eyebrow { margin: 0; color: var(--project-accent); }
  .narrative-flow__heading strong { font: 500 clamp(18px, 2vw, 23px)/1.25 var(--font-display); letter-spacing: -.025em; text-align: right; }
  .narrative-flow__groups { display: grid; grid-template-columns: repeat(var(--flow-columns), minmax(0, 1fr)); gap: 14px; }
  .narrative-flow__group { position: relative; min-width: 0; padding: 14px; border: 1px solid var(--line); border-radius: 4px; background: var(--elevated); }
  .narrative-flow__group--service, .narrative-flow__group--package { border-style: dashed; border-color: color-mix(in srgb, var(--project-accent) 58%, var(--line)); }
  .narrative-flow__group--player { border-color: color-mix(in srgb, var(--project-accent) 65%, var(--line)); }
  .narrative-flow__group h3 { min-height: 32px; margin: 0 0 14px; color: var(--muted); font: 600 11px/1.35 var(--font-body); letter-spacing: .085em; text-transform: uppercase; }
  .narrative-flow__group ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .narrative-flow__group li { min-width: 0; }
  .narrative-flow__node { display: grid; align-content: center; min-height: 64px; gap: 3px; padding: 11px 12px; border: 1px solid var(--line-strong); border-radius: 3px; background: var(--bg); color: var(--text); font-size: 14px; line-height: 1.35; }
  .narrative-flow__group--player .narrative-flow__node { border-radius: 999px; text-align: center; }
  .narrative-flow__node small { color: var(--muted); font-size: 11px; line-height: 1.35; }
  .narrative-flow__step-link { display: flex; align-items: center; gap: 9px; min-height: 38px; padding-left: 11px; color: var(--project-accent); }
  .narrative-flow__step-link :global(svg) { flex: none; color: var(--project-accent); }
  .narrative-flow__step-link small { color: var(--secondary); font-size: 11px; line-height: 1.2; }
  .narrative-flow__handoff { display: flex; align-items: center; gap: 8px; min-height: 33px; margin: 12px 0 0; color: var(--secondary); font-size: 11px; line-height: 1.3; }
  .narrative-flow__handoff--async { padding-top: 6px; border-top: 1px dashed var(--project-accent); }
  .narrative-flow__handoff :global(svg) { flex: none; color: var(--project-accent); }
  .narrative-flow__notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; margin-top: 18px; }
  .narrative-flow__notes p { display: grid; gap: 3px; margin: 0; padding: 12px 14px; border-left: 1px dashed var(--project-accent); color: var(--secondary); font-size: 12px; line-height: 1.45; }
  .narrative-flow__notes strong { color: var(--text); font-size: 11px; font-weight: 600; letter-spacing: .03em; }
  .narrative-flow__caption { max-width: 92ch; margin: 20px 0 0; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; line-height: 1.5; }
  @media (max-width: 1024px) {
    .narrative-flow__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .narrative-flow__heading { display: block; }
    .narrative-flow__heading .eyebrow { margin-bottom: 6px; }
    .narrative-flow__heading strong { display: block; text-align: left; }
  }
  @media (max-width: 620px) {
    .narrative-flow { padding: 16px; }
    .narrative-flow__groups { grid-template-columns: minmax(0, 1fr); }
    .narrative-flow__group { padding: 12px; }
    .narrative-flow__group h3 { min-height: 0; }
    .narrative-flow__handoff { margin-top: 8px; }
    .narrative-flow__handoff :global(svg) { transform: rotate(90deg); }
    .narrative-flow__notes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
