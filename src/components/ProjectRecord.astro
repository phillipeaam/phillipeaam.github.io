---
import ExternalLink from './ExternalLink.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import ArchiveMedia from './ArchiveMedia.astro';
import RichProjectRecord from './RichProjectRecord.astro';
import { hasPublishableCaseStudy, isPortfolioIncluded, type ProjectRecord } from '../data/projects';

const { project, homePath = '/' } = Astro.props as { project: ProjectRecord; homePath?: string };
const recordId = project.anchorId ?? project.id;
const tier = project.archivePresentation ?? 'compact';
const caseHref = isPortfolioIncluded(project) && hasPublishableCaseStudy(project) ? `${homePath}work/${project.caseStudy.slug}/` : undefined;
const [leadMedia, ...supportingMedia] = project.media ?? [];
const period = project.period && project.period !== 'Undated' ? project.period : undefined;
const titleId = `archive-title-${project.id}`;
---
<li class:list={['archive-record', `archive-record--${tier}`, leadMedia && 'archive-record--media', tier === 'rich' && !leadMedia && 'archive-record--no-media']} id={recordId}>
  {tier === 'rich' ? <RichProjectRecord project={project} homePath={homePath} /> : <article aria-labelledby={titleId}>
    <header class="archive-record__header">
      <div class="archive-record__identity">
        <h3 id={titleId}>{project.name}</h3>
          {(project.context ?? project.type) && <p class="archive-record__context">{project.context ?? project.type}</p>}
      </div>
      {period && <span class="archive-record__period">{period}</span>}
    </header>
    {leadMedia && <div class="archive-record__media">
      {leadMedia.previewSrc && leadMedia.type === 'image'
        ? <ProjectMediaPreview posterSrc={leadMedia.src} previewSrc={leadMedia.previewSrc} alt={leadMedia.alt} previewAlt={leadMedia.previewAlt} caption={leadMedia.caption} posterWidth={leadMedia.posterWidth} posterHeight={leadMedia.posterHeight} posterFit={leadMedia.posterFit} autoplayPreview={leadMedia.autoplayPreview} />
        : <ArchiveMedia media={leadMedia} projectName={project.name} />}
      {supportingMedia.length > 0 && <div class="archive-record__supporting-media">
        {supportingMedia.slice(0, 3).map((media) => <ArchiveMedia media={media} projectName={project.name} />)}
      </div>}
    </div>}
      <div class="archive-record__body">
          <p class="archive-record__overview">{project.summary}</p>
        {project.contribution && <div class="archive-record__contribution">
          <p class="archive-record__label">My contribution</p>
          <p>{project.contribution}</p>
        </div>}
        {project.engineeringFocus && <div class="archive-record__contribution">
          <p class="archive-record__label">Engineering focus</p>
          <p>{project.engineeringFocus}</p>
        </div>}
      </div>
      {(project.specs?.length ?? 0) > 0 && <dl class="archive-record__specs">
        {project.specs?.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
      </dl>}
      {(caseHref || (isPortfolioIncluded(project) && project.actions?.length)) && <nav class="archive-record__actions" aria-label={`${project.name} links`}>
        {caseHref && <a href={caseHref} aria-label={`View ${project.name} case study`}>View case study <span aria-hidden="true">→</span></a>}
        {isPortfolioIncluded(project) && project.actions?.map((action) => <ExternalLink href={action.href} ariaLabel={`${action.label} for ${project.name} (opens in a new tab)`} icon>{action.label}</ExternalLink>)}
      </nav>}
  </article>}
</li>
