---
import ExternalLink from './ExternalLink.astro';
import ArchiveMedia from './ArchiveMedia.astro';
import type { ProjectMedia, PublicProjectCatalogEntry } from '../data/projects';

const { project, homePath = '/', approvedMedia = [], approvedIdentityImage } = Astro.props as { project: PublicProjectCatalogEntry; homePath?: string; approvedMedia?: ProjectMedia[]; approvedIdentityImage?: string };
const recordId = project.anchorId ?? project.id;
const caseHref = project.caseStudySlug ? `${homePath}work/${project.caseStudySlug}/` : undefined;
const period = project.period && project.period !== 'Undated' ? project.period : undefined;
const titleId = `archive-title-${project.id}`;
const summaryId = `archive-summary-${project.id}`;
const contextLabel = project.workContext === 'professional' ? 'Professional' : project.workContext === 'independent' ? 'Independent' : 'Study';
const eligibleMedia = approvedMedia.filter((media) => media.src && media.alt && (media.type !== 'gif' || media.posterSrc));
const [primaryMedia, ...detailMedia] = eligibleMedia.filter((media, index, items) => items.findIndex((item) => item.src === media.src) === index);
const publicMetadata = project.specs?.filter(({ label }) => !['Context', 'Period', 'Type', 'Stack', 'Engine', 'Tools'].includes(label)) ?? [];
const hasDetails = Boolean(project.contribution || project.engineeringFocus || project.context || project.workContext || period || project.type || publicMetadata.length || project.technologies.length || detailMedia.length || caseHref || project.actions?.length);
const displayType = project.type.replace(/^professional(?:\s*[·:—-]\s*|\s+)/i, '');
const productSummary = project.product.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() ?? project.product;
const additionalProduct = project.product.slice(productSummary.length).trim();
---
<li class="archive-record" id={recordId} data-project-record data-context={project.workContext} data-technologies={project.technologies.join('|')}>
  <article class:list={['archive-record__entry', primaryMedia && 'archive-record__entry--media']} aria-labelledby={titleId}>
    {primaryMedia && <div class="archive-record__primary-media"><ArchiveMedia media={primaryMedia} projectName={project.name} hideControls /></div>}
    <div class="archive-record__entry-content">
      <header class="archive-record__header">
        <div class="archive-record__identity">
          {approvedIdentityImage && <img class="archive-record__identity-image" src={approvedIdentityImage} alt="" width="52" height="52" loading="lazy" decoding="async" />}
          <h2 id={titleId}><a class="archive-record__title-link" href={`#${recordId}`}>{project.name}</a></h2>
        </div>
      </header>
      <p class="archive-record__overview" id={summaryId}>{productSummary}</p>
    {hasDetails && <details class="archive-record__details">
      <summary aria-describedby={summaryId}>Project details</summary>
      <div class:list={['archive-record__details-layout', detailMedia.length === 0 && 'archive-record__details-layout--text-only']}>
        {detailMedia.length > 0 && <div class="archive-record__media-column" aria-label={`${project.name} media`}>
          {detailMedia.map((media) => <ArchiveMedia media={media} projectName={project.name} hideControls />)}
        </div>}
        <div class="archive-record__details-content">
          {additionalProduct && <div class="archive-record__contribution">
            <p class="archive-record__label">Product</p>
            <p>{additionalProduct}</p>
          </div>}
          {(project.context || contextLabel) && <div class="archive-record__contribution">
            <p class="archive-record__label">Context</p>
            <p>{contextLabel}{project.context ? ` · ${project.context}` : ''}</p>
          </div>}
          {(period || displayType) && <dl class="archive-record__specs">
            {displayType && <div><dt>Type</dt><dd>{displayType}</dd></div>}
            {period && <div><dt>Period</dt><dd>{period}</dd></div>}
          </dl>}
          {project.contribution && <div class="archive-record__contribution">
            <p class="archive-record__label">Contribution</p>
            <p>{project.contribution}</p>
          </div>}
          {project.engineeringFocus && <div class="archive-record__contribution">
            <p class="archive-record__label">Engineering focus</p>
            <p>{project.engineeringFocus}</p>
          </div>}
          {project.technologies.length > 0 && <div class="archive-record__technology-group">
            <p class="archive-record__label">Technology</p>
            <ul class="archive-record__technology-list" aria-label={`${project.name} technologies`}>
              {project.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
          </div>}
          {publicMetadata.length > 0 && <dl class="archive-record__specs">
            {publicMetadata.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
          </dl>}
          {(caseHref || project.actions?.length) && <nav class="archive-record__actions" aria-label={`${project.name} links`}>
            {caseHref && <a href={caseHref}>View case study <span aria-hidden="true">→</span></a>}
            {project.actions?.map((action) => <ExternalLink href={action.href} ariaLabel={`${action.label} for ${project.name} (opens in a new tab)`} icon>{action.label}</ExternalLink>)}
          </nav>}
        </div>
      </div>
    </details>}
    </div>
  </article>
</li>
