---
const { role, organization, dates, note, href } = Astro.props;
---
<article class="experience-row">
  <div><h3>{role}</h3><p>{organization}{note && <span class="experience-note"> · {note}</span>}</p></div>
  <p class="experience-dates">{dates}</p>
  {href && <a class="row-link" href={href} aria-label={`View related work: ${organization}`}>Related work <span aria-hidden="true">↗</span></a>}
</article>
