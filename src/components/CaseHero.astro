---
import MediaPoster from './MediaPoster.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import Icon from './Icon.astro';
const { project, media, summary, statement, links } = Astro.props;
---
<header class="case-hero">
  <h1>{project.name}</h1>
  {summary && <p class="case-hero__summary">{summary}</p>}
  {statement && <p class="case-hero__statement">{statement}</p>}
  {media
    ? <ProjectMediaPreview
        src={media.src}
        previewSrc={media.previewSrc}
        alt={media.alt}
        previewAlt={media.previewAlt}
        caption={media.caption}
        posterWidth={media.posterWidth}
        posterHeight={media.posterHeight}
        posterFit={media.posterFit}
        autoplayPreview={media.autoplayPreview}
      />
    : <MediaPoster label={project.evidenceLabel} kind={project.kind} />}
  {links?.length > 0 && <div class="case-hero__actions">{links.map((link: { label: string; href: string }) => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer"><span>{link.label}</span><Icon name="external" size={15} /></a>)}</div>}
</header>

<style>
  .case-hero__summary { margin: 0 0 20px; color: var(--secondary); font-size: clamp(15px, 1.5vw, 18px); }
  .case-hero__summary:has(+ .case-hero__statement) { margin-bottom: 10px; }
  .case-hero__statement { max-width: 70ch; margin: 0 0 24px; color: var(--text); font-size: clamp(17px, 1.7vw, 21px); line-height: 1.5; }
  .case-hero__actions { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 16px; }
  @media (max-width: 480px) { .case-hero__actions { display: grid; gap: 2px; } }
</style>
