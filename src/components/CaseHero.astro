---
import MediaPoster from './MediaPoster.astro';
const { project, role } = Astro.props;
---
<header class="case-hero">
  <p class="eyebrow">{project.context}</p>
  <h1>{project.name}</h1>
  <p class="case-role">{role}</p>
  <p class="case-intro">{project.product}</p>
  <p class="case-ownership-intro">{project.contribution}</p>
  <MediaPoster label={project.evidenceLabel} kind={project.kind} />
</header>
