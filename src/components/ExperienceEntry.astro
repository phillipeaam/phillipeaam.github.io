---
import Icon from './Icon.astro';
import type { Experience } from '../data/experience';
import { resolveExperienceWork } from '../data/projects';
const { item } = Astro.props as { item: Experience };
const homePath = import.meta.env.BASE_URL;
const selectedWork = item.selectedWork.map((reference) => {
  const project = resolveExperienceWork(reference.projectId, homePath);
  return { ...project, label: reference.label ?? project.name };
});
---
<article class="experience-entry">
  <header class="experience-entry-header">
    <div class="experience-company-identity">
      <a class="experience-company" href={item.companyUrl} target="_blank" rel="noopener noreferrer" aria-label={`${item.organization} on LinkedIn, opens in a new tab`}>
        {item.companyLogo ? <img class="experience-company-mark" src={item.companyLogo} alt="" width="48" height="48" /> : <span class="experience-company-mark" aria-hidden="true">{item.companyMark}</span>}
        <span class="experience-company-copy">
          <span class="experience-company-title">
            <span class="experience-company-name">{item.organization}</span>
            <Icon name="external" size={14} />
          </span>
          <span class="experience-period">{item.dates}</span>
        </span>
      </a>
    </div>
    <h3>{item.role}</h3>
  </header>
  <div class="experience-main">
    <p class="experience-context">{item.context}</p>
    <p class="experience-subheading">Selected highlights</p>
    <ul class="experience-highlights">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    {selectedWork.length > 0 && <nav class="experience-selected-work" aria-label={`Selected work at ${item.organization}`}><span class="experience-subheading">Selected work</span><ul class="experience-work-list">{selectedWork.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>}
  </div>
</article>
