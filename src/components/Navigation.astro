---
const homeItems = [
  { id: 'home', label: 'Home' },
  { id: 'work', label: 'Work' },
  { id: 'projects', label: 'Projects' },
  { id: 'recommendations', label: 'Teammates' },
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact', href: '#contact' },
];
const homePath = import.meta.env.BASE_URL;
const isHome = Astro.url.pathname === homePath;
const { contextual = false } = Astro.props;
const contextualItems = [
  { id: 'home', label: '← Back', href: homePath, className: 'nav-link--return' },
  { id: 'contact', label: 'Contact', href: '#contact' },
];
const caseItems = [
  { id: 'home', label: '← Back', href: homePath, className: 'nav-link--return' },
  { id: 'contact', label: 'Contact', href: '#contact' },
];
const { caseNavigation = false } = Astro.props;
const items = caseNavigation ? caseItems : contextual ? contextualItems : homeItems;
const itemHref = (id: string) => id === 'home'
  ? (isHome ? '#top' : `${homePath}#top`)
  : (isHome ? `#${id}` : `${homePath}#${id}`);
const hrefFor = (item: typeof homeItems[number] | typeof contextualItems[number]) => 'href' in item ? item.href : itemHref(item.id);
---
<header class="site-header">
  <nav class="nav-shell content-width" aria-label="Main navigation">
    <div class="wordmark">
      <a href={homePath} data-home-identity aria-label="Phillipe Augusto — Home">
        <img class="wordmark-avatar" src="/images/identity/phillipe-augusto-avatar.webp" alt="" width="32" height="32" />
      </a>
      <a href={homePath} data-home-identity aria-label="Phillipe Augusto — Home">Phillipe Augusto</a>
    </div>
    <div class="nav-desktop">
      {items.map((item) => <a class:list={['nav-link', 'className' in item && item.className]} href={hrefFor(item)} data-section={'className' in item && item.className === 'nav-link--return' ? undefined : item.id}>{item.label}</a>)}
    </div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation menu">
      <span></span><span></span>
    </button>
    <div class="nav-mobile" id="mobile-navigation" hidden>
      {items.map((item) => <a class:list={['nav-link', 'className' in item && item.className]} href={hrefFor(item)} data-section={'className' in item && item.className === 'nav-link--return' ? undefined : item.id}>{item.label}</a>)}
    </div>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-navigation');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link[data-section]'));
  const homeSections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-section]'));
  const archiveGroups = Array.from(document.querySelectorAll<HTMLElement>('.archive-group'));
  const homeScrollKey = 'portfolio-home-scroll-y';
  const restoreHomeKey = 'portfolio-restore-home-scroll';
  const isHomePage = window.location.pathname === import.meta.env.BASE_URL;
  document.querySelectorAll<HTMLAnchorElement>('[data-home-identity]').forEach((link) => {
    link.addEventListener('click', (event) => {
      sessionStorage.removeItem(restoreHomeKey);
      if (!isHomePage) return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      event.preventDefault();
      window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      if (window.location.href !== link.href) {
        window.history.replaceState(window.history.state, '', import.meta.env.BASE_URL);
      }
    });
  });
  let activeSection: string | null = null;
  const updateActiveLink = (sectionId: string | null) => {
    activeSection = sectionId;
    navLinks.forEach((link) => {
      const selected = Boolean(sectionId && link.dataset.section === sectionId);
      link.classList.toggle('is-current', selected);
      if (selected && link.getClientRects().length > 0) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  const closeMenu = () => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open navigation menu');
    menu.hidden = true;
    updateActiveLink(activeSection);
  };
  toggle?.addEventListener('click', () => {
    if (!toggle || !menu) return;
    const opening = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(opening));
    toggle.setAttribute('aria-label', opening ? 'Close navigation menu' : 'Open navigation menu');
    menu.hidden = !opening;
    updateActiveLink(activeSection);
  });
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });
  window.addEventListener('resize', () => { if (window.innerWidth > 820) closeMenu(); });
  updateActiveLink(null);

  if (!isHomePage) {
    document.querySelectorAll<HTMLAnchorElement>('.nav-link--return').forEach((link) => {
      link.addEventListener('click', () => sessionStorage.setItem(restoreHomeKey, 'true'));
    });
  } else {
    let scrollSaveFrame = 0;
    let leavingHome = false;
    const saveHomeScroll = () => {
      if (leavingHome || document.documentElement.dataset.restoringHomeScroll === 'true') return;
      sessionStorage.setItem(homeScrollKey, String(window.scrollY));
    };
    document.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
      if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
      const destination = new URL(link.href);
      if (destination.origin !== location.origin || destination.pathname === location.pathname) return;
      saveHomeScroll();
      leavingHome = true;
    });
    window.addEventListener('pageshow', () => { leavingHome = false; });
    window.addEventListener('scroll', () => {
      if (scrollSaveFrame) return;
      scrollSaveFrame = window.requestAnimationFrame(() => {
        scrollSaveFrame = 0;
        saveHomeScroll();
      });
    }, { passive: true });
    window.addEventListener('pagehide', saveHomeScroll);

  }

  if (window.location.pathname === import.meta.env.BASE_URL && homeSections.length > 0 && 'IntersectionObserver' in window) {
    let sectionObserver: IntersectionObserver | undefined;
    let resizeFrame = 0;
    let lastSectionBeforeFooter: string | null = null;
    let footerIsActive = false;
    const footer = document.querySelector<HTMLElement>('.site-footer');

    const observeReadingPosition = () => {
      sectionObserver?.disconnect();
      const rootStyle = getComputedStyle(document.documentElement);
      const headerOffset = Number.parseFloat(rootStyle.getPropertyValue('--anchor-offset')) || 104;
      const bandBottom = Math.max(headerOffset + 1, Math.round(window.innerHeight * 0.38));
      sectionObserver = new IntersectionObserver((entries) => {
        const entering = entries.filter((entry) => entry.isIntersecting);
        if (entering.length > 0) {
          entering.sort((a, b) => Math.abs(a.boundingClientRect.top - headerOffset) - Math.abs(b.boundingClientRect.top - headerOffset));
          updateActiveLink((entering[0].target as HTMLElement).dataset.navSection ?? null);
          return;
        }
        const activeEntry = entries.find((entry) => (entry.target as HTMLElement).dataset.navSection === activeSection);
        if (activeEntry && activeEntry.boundingClientRect.top >= bandBottom) updateActiveLink(null);
      }, { rootMargin: `-${headerOffset}px 0px -${window.innerHeight - bandBottom}px 0px`, threshold: 0 });
      homeSections.forEach((section) => sectionObserver?.observe(section));
    };

    observeReadingPosition();
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(observeReadingPosition);
    }, { passive: true });

    if (footer) {
      const footerObserver = new IntersectionObserver((entries) => {
        const footerVisible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.5);
        if (footerVisible && !footerIsActive) {
          lastSectionBeforeFooter = activeSection;
          footerIsActive = true;
          updateActiveLink('contact');
        } else if (!footerVisible && footerIsActive) {
          footerIsActive = false;
          const rootStyle = getComputedStyle(document.documentElement);
          const readingLine = Number.parseFloat(rootStyle.getPropertyValue('--anchor-offset')) || 104;
          const sectionAtReadingLine = homeSections.find((section) => {
            const rect = section.getBoundingClientRect();
            return rect.top <= readingLine && rect.bottom > readingLine;
          });
          updateActiveLink(sectionAtReadingLine?.dataset.navSection ?? lastSectionBeforeFooter);
        }
      }, { threshold: 0.5 });
      footerObserver.observe(footer);
    }
  }

  if (archiveGroups.length > 0) {
    navLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== window.location.origin || destination.pathname !== window.location.pathname || !destination.hash) return;

        let targetId: string;
        try {
          targetId = decodeURIComponent(destination.hash.slice(1));
        } catch {
          return;
        }

        const target = document.getElementById(targetId);
        if (!target) return;

        event.preventDefault();
        if (destination.href !== window.location.href) {
          window.history.pushState(null, '', `${destination.pathname}${destination.search}${destination.hash}`);
        }

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });

        const group = target.closest<HTMLElement>('.archive-group');
        if (group) updateActiveLink(group.id);
      });
    });
  }

  if (archiveGroups.length > 0 && 'IntersectionObserver' in window) {
    let archiveObserver: IntersectionObserver | undefined;
    let resizeFrame = 0;
    const readingLine = () => Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--anchor-offset')) || 104;
    const activateGroupAtHash = () => {
      const targetId = decodeURIComponent(window.location.hash.slice(1));
      const target = targetId ? document.getElementById(targetId) : null;
      const group = target?.closest<HTMLElement>('.archive-group');
      if (group) updateActiveLink(group.id);
    };
    const observeArchivePosition = () => {
      archiveObserver?.disconnect();
      const headerOffset = readingLine();
      const bandBottom = Math.max(headerOffset + 1, Math.round(window.innerHeight * 0.38));
      archiveObserver = new IntersectionObserver((entries) => {
        const entering = entries.filter((entry) => entry.isIntersecting);
        if (entering.length > 0) {
          entering.sort((a, b) => Math.abs(a.boundingClientRect.top - headerOffset) - Math.abs(b.boundingClientRect.top - headerOffset));
          updateActiveLink((entering[0].target as HTMLElement).id);
          return;
        }
        const currentGroup = archiveGroups.find((group) => group.id === activeSection);
        if (currentGroup) {
          const rect = currentGroup.getBoundingClientRect();
          if (rect.top > bandBottom || rect.bottom < headerOffset) updateActiveLink(null);
        }
      }, { rootMargin: `-${headerOffset}px 0px -${window.innerHeight - bandBottom}px 0px`, threshold: 0 });
      archiveGroups.forEach((group) => archiveObserver?.observe(group));
      activateGroupAtHash();
    };
    observeArchivePosition();
    window.addEventListener('hashchange', activateGroupAtHash);
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(observeArchivePosition);
    }, { passive: true });
  }
</script>
