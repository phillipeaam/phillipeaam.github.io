---
import MediaPoster from './MediaPoster.astro';
import EvidenceCaption from './EvidenceCaption.astro';
import SystemDiagram from './SystemDiagram.astro';
import MermaidDiagram from './MermaidDiagram.astro';
import NarrativeEngineeringStory from './NarrativeEngineeringStory.astro';
const { story, index, kind } = Astro.props;
const hasFields = Boolean(story.fields?.length);
const hasEvidence = Boolean(story.evidenceLabel || story.behavior || story.evidence);
const hasDiagram = Boolean(story.mermaid || story.diagram?.length);
---
{story.narrative ? <NarrativeEngineeringStory story={story} index={index} /> : <section class:list={['engineering-story', story.compact && 'story-compact']} aria-labelledby={`story-${index}`}>
  <div class="story-heading"><p class="eyebrow">ENGINEERING STORY <span class="story-index">{String(index).padStart(2, '0')}</span></p><h2 id={`story-${index}`}>{story.title}</h2><p class="story-framing">{story.framing}</p></div>
  {(hasFields || hasEvidence || hasDiagram) && <div class="story-body">
    {hasFields && <dl class="story-fields">{story.fields.map((field: { label: string; text: string }) => <div><dt>{field.label}</dt><dd>{field.text}</dd></div>)}</dl>}
    {story.compact
      ? story.evidence && <div class="story-compact-evidence"><p class="eyebrow">EVIDENCE BOUNDARY</p><p>{story.evidence}</p></div>
      : <>
          {hasEvidence && <div class="story-evidence">{story.evidenceLabel && <MediaPoster label={story.evidenceLabel} kind={kind} />}<EvidenceCaption behavior={story.behavior} contribution={story.evidence} /></div>}
          {story.mermaid ? <MermaidDiagram title={story.diagramLabel} code={story.mermaid} /> : story.diagram?.length ? <SystemDiagram title={story.diagramLabel} nodes={story.diagram} /> : null}
        </>}
  </div>}
</section>}
