---
const homePath = import.meta.env.BASE_URL;
const resumeHref = `${homePath}resume/Phillipe_Augusto_Resume.pdf`;
const utilities = [
  { label: 'GitHub', href: 'https://github.com/phillipeaam' },
  { label: 'itch.io', href: 'https://phillipeaam.itch.io/' },
  { label: 'YouTube', href: 'https://www.youtube.com/@phillipeaam' },
];
---

<footer class="site-footer">
  <div class="content-width footer-inner">
    <nav class="footer-utilities" aria-label="Resume and profiles">
      <ul class="footer-utility-list">
        <li><a class="footer-utility-link" href={resumeHref} target="_blank" rel="noopener noreferrer">Resume</a></li>
        {utilities.map(({ label, href }) => <li><a class="footer-utility-link" href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Phillipe Augusto</span>
    </div>
  </div>
</footer>
