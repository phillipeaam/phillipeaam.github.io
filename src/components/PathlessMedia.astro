---
const { posterSrc, previewSrc, caption, autoplayPreview = false } = Astro.props;
---
<figure class="media-figure pathless-media">
  <div class="media-poster pathless-media-poster" data-pathless-preview data-autoplay-preview={autoplayPreview ? 'true' : undefined} data-poster-src={posterSrc} data-preview-src={previewSrc}>
    <img
      class="media-poster-image"
      src={posterSrc}
      alt="Pathless title poster over a helicopter rescue-game scene"
      loading="lazy"
      decoding="async"
      width="2556"
      height="1432"
      data-pathless-image
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const previewAreas = document.querySelectorAll<HTMLElement>('[data-pathless-preview]:not([data-bound])');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const showPoster = (area: HTMLElement) => {
    const image = area.querySelector<HTMLImageElement>('[data-pathless-image]');
    if (!image || image.src === new URL(area.dataset.posterSrc ?? '', window.location.href).href) return;
    image.src = area.dataset.posterSrc ?? '';
  };

  for (const area of previewAreas) {
    area.dataset.bound = 'true';
    if (area.dataset.autoplayPreview === 'true' && !reducedMotion.matches) {
      const image = area.querySelector<HTMLImageElement>('[data-pathless-image]');
      if (image && area.dataset.previewSrc) image.src = area.dataset.previewSrc;
    }
    if (area.dataset.autoplayPreview !== 'true') {
      area.addEventListener('pointerenter', () => {
        if (reducedMotion.matches) return;
        const image = area.querySelector<HTMLImageElement>('[data-pathless-image]');
        if (image && area.dataset.previewSrc) image.src = area.dataset.previewSrc;
      });
      area.addEventListener('pointerleave', () => showPoster(area));
    }
  }

  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) previewAreas.forEach(showPoster);
  });
</script>
