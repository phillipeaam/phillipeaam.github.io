---
const {
  posterSrc,
  previewSrc,
  alt = '',
  previewAlt,
  caption,
  autoplayPreview = false,
  showAnimatedDirectly = false,
  posterWidth = 2556,
  posterHeight = 1432,
  posterFit = 'cover',
} = Astro.props;
---
<figure class="media-figure project-media-preview">
  <div class="media-poster project-media-preview__poster" data-project-media-preview={showAnimatedDirectly ? undefined : ''} data-autoplay-preview={!showAnimatedDirectly && autoplayPreview ? 'true' : undefined} data-poster-src={showAnimatedDirectly ? undefined : posterSrc} data-preview-src={showAnimatedDirectly ? undefined : previewSrc} data-poster-alt={showAnimatedDirectly ? undefined : alt} data-preview-alt={showAnimatedDirectly ? undefined : previewAlt}>
    {showAnimatedDirectly && previewSrc
      ? <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset={posterSrc} />
          <img
            class:list={['media-poster-image', posterFit === 'contain' && 'media-poster-image--contain']}
            src={previewSrc}
            alt={previewAlt ?? alt}
            loading="eager"
            decoding="async"
            width={posterWidth}
            height={posterHeight}
          />
        </picture>
      : <img
          class:list={['media-poster-image', posterFit === 'contain' && 'media-poster-image--contain']}
          src={posterSrc}
          alt={alt}
          loading="lazy"
          decoding="async"
          width={posterWidth}
          height={posterHeight}
          data-project-media-image
        />}
  </div>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>

<script>
  const previewAreas = document.querySelectorAll<HTMLElement>('[data-project-media-preview]:not([data-bound])');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const refreshPreview = new Map<HTMLElement, () => void>();

  const showPoster = (area: HTMLElement) => {
    const image = area.querySelector<HTMLImageElement>('[data-project-media-image]');
    if (!image) return;
    image.alt = area.dataset.posterAlt ?? '';
    const posterSrc = area.dataset.posterSrc ?? '';
    if (image.src !== new URL(posterSrc, window.location.href).href) image.src = posterSrc;
  };

  const showPreview = (area: HTMLElement) => {
    const image = area.querySelector<HTMLImageElement>('[data-project-media-image]');
    const previewSrc = area.dataset.previewSrc;
    if (!image || !previewSrc || reducedMotion.matches) return;
    image.alt = area.dataset.previewAlt ?? area.dataset.posterAlt ?? '';
    image.src = previewSrc;
  };

  for (const area of previewAreas) {
    area.dataset.bound = 'true';
    const image = area.querySelector<HTMLImageElement>('[data-project-media-image]');
    const link = area.closest('a');
    image?.addEventListener('error', () => {
      if (image.src === new URL(area.dataset.previewSrc ?? '', window.location.href).href) showPoster(area);
    });

    let pointerActive = false;
    let focusActive = false;
    const updatePreview = () => {
      if (reducedMotion.matches) {
        showPoster(area);
        return;
      }

      if (area.dataset.autoplayPreview === 'true') {
        showPreview(area);
        return;
      }

      if ((pointerActive && fineHover.matches) || focusActive) showPreview(area);
      else showPoster(area);
    };
    refreshPreview.set(area, updatePreview);

    area.addEventListener('pointerenter', () => {
      pointerActive = fineHover.matches;
      updatePreview();
    });
    area.addEventListener('pointerleave', () => {
      pointerActive = false;
      updatePreview();
    });
    link?.addEventListener('focus', () => {
      focusActive = true;
      updatePreview();
    });
    link?.addEventListener('blur', () => {
      focusActive = false;
      updatePreview();
    });
  }

  reducedMotion.addEventListener('change', () => {
    previewAreas.forEach((area) => refreshPreview.get(area)?.());
  });

  fineHover.addEventListener('change', () => previewAreas.forEach((area) => refreshPreview.get(area)?.()));
</script>
