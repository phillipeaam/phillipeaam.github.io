---
const {
  posterSrc,
  previewSrc,
  alt = '',
  previewAlt,
  caption,
  autoplayPreview = false,
  posterWidth = 2556,
  posterHeight = 1432,
  posterFit = 'cover',
} = Astro.props;
---
<figure class="media-figure project-media-preview">
  <div
    class="media-poster project-media-preview__poster"
    data-project-media-preview
    data-autoplay-preview={autoplayPreview ? 'true' : undefined}
    data-preview-src={previewSrc}
    data-poster-alt={alt}
    data-preview-alt={previewAlt ?? alt}
  >
    <img
      class:list={['media-poster-image', posterFit === 'contain' && 'media-poster-image--contain']}
      src={posterSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
      width={posterWidth}
      height={posterHeight}
      data-project-media-fallback
    />
    {previewSrc && <img
      class:list={['media-poster-image', 'project-media-preview__animation', posterFit === 'contain' && 'media-poster-image--contain']}
      alt=""
      aria-hidden="true"
      hidden
      decoding="async"
      width={posterWidth}
      height={posterHeight}
      data-project-media-animation
    />}
  </div>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>

<script>
  const previewAreas = document.querySelectorAll<HTMLElement>('[data-project-media-preview]:not([data-bound])');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const refreshPreview = new Map<HTMLElement, () => void>();

  for (const area of previewAreas) {
    area.dataset.bound = 'true';
    const fallback = area.querySelector<HTMLImageElement>('[data-project-media-fallback]');
    const animation = area.querySelector<HTMLImageElement>('[data-project-media-animation]');
    const previewSrc = area.dataset.previewSrc;
    const link = area.closest('a');
    let pointerActive = false;
    let focusActive = false;
    let ready = false;
    let failed = false;
    let requested = area.dataset.autoplayPreview === 'true';

    const showFallback = () => {
      if (!fallback || !animation) return;
      fallback.hidden = false;
      fallback.alt = area.dataset.posterAlt ?? '';
      animation.hidden = true;
      animation.alt = '';
      animation.setAttribute('aria-hidden', 'true');
    };

    const showAnimation = () => {
      if (!fallback || !animation || !ready || reducedMotion.matches || !requested) {
        showFallback();
        return;
      }
      fallback.hidden = true;
      fallback.alt = '';
      animation.hidden = false;
      animation.alt = area.dataset.previewAlt ?? area.dataset.posterAlt ?? '';
      animation.removeAttribute('aria-hidden');
    };

    const loadAnimation = () => {
      if (!animation || !previewSrc || reducedMotion.matches || failed || animation.src) return;
      animation.addEventListener('load', () => {
        if (animation.naturalWidth === 0 || animation.naturalHeight === 0) {
          failed = true;
          showFallback();
          return;
        }
        animation.decode().then(() => {
          ready = true;
          showAnimation();
        }).catch(() => {
          failed = true;
          showFallback();
        });
      }, { once: true });
      animation.addEventListener('error', () => {
        failed = true;
        showFallback();
      }, { once: true });
      animation.src = previewSrc;
    };

    const updatePreview = () => {
      requested = area.dataset.autoplayPreview === 'true'
        || (pointerActive && fineHover.matches)
        || focusActive;
      if (reducedMotion.matches || !requested || !previewSrc) {
        showFallback();
        return;
      }
      if (ready) showAnimation();
      else {
        showFallback();
        loadAnimation();
      }
    };

    refreshPreview.set(area, updatePreview);
    area.addEventListener('pointerenter', () => {
      pointerActive = fineHover.matches;
      updatePreview();
    });
    area.addEventListener('pointerleave', () => {
      pointerActive = false;
      updatePreview();
    });
    link?.addEventListener('focus', () => {
      focusActive = true;
      updatePreview();
    });
    link?.addEventListener('blur', () => {
      focusActive = false;
      updatePreview();
    });
    updatePreview();
  }

  reducedMotion.addEventListener('change', () => {
    previewAreas.forEach((area) => refreshPreview.get(area)?.());
  });
  fineHover.addEventListener('change', () => {
    previewAreas.forEach((area) => refreshPreview.get(area)?.());
  });
</script>
