---
import MediaPoster from './MediaPoster.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import Icon from './Icon.astro';
import { hasPublishableCaseStudy, isPortfolioIncluded, type ProjectRecord } from '../data/projects';
const { project, reverse = false } = Astro.props as { project: ProjectRecord; reverse?: boolean };
const [leadMedia] = project.media ?? [];
const homePath = import.meta.env.BASE_URL;
const caseHref = isPortfolioIncluded(project) && hasPublishableCaseStudy(project) ? `${homePath}work/${project.caseStudy.slug}/` : undefined;
const archiveHref = isPortfolioIncluded(project) && project.homeArchiveLink && project.anchorId ? `${homePath}projects/#${project.anchorId}` : undefined;
---
<article class:list={['featured-project', reverse && 'is-reversed']} data-kind={project.kind}>
  {leadMedia?.type === 'image' && leadMedia.previewSrc
    ? <ProjectMediaPreview posterSrc={leadMedia.src} previewSrc={leadMedia.previewSrc} alt={leadMedia.alt} previewAlt={leadMedia.previewAlt} posterWidth={leadMedia.posterWidth} posterHeight={leadMedia.posterHeight} posterFit={leadMedia.posterFit} autoplayPreview={leadMedia.autoplayPreview} linkHref={caseHref} linkLabel={caseHref ? `Open ${project.name} case study` : undefined} linkClass={caseHref ? 'featured-project__media-link' : undefined} />
    : caseHref
      ? <a class="featured-project__media-link" href={caseHref} aria-label={`Open ${project.name} case study`}><MediaPoster label={project.evidenceLabel ?? project.name} kind={project.kind ?? 'neutral'} /></a>
      : <MediaPoster label={project.evidenceLabel ?? project.name} kind={project.kind ?? 'neutral'} />}
  <div class="featured-copy">
    <h3>{caseHref ? <a href={caseHref}>{project.name}</a> : project.name}</h3>
    <p class="project-product">{project.summary}</p>
    {project.contribution && <p class="project-contribution">{project.contribution}</p>}
    {(caseHref || archiveHref) && <div class="featured-project__actions">
      {caseHref && <a class="text-link" href={caseHref}>Explore case study <Icon name="arrow" size={16} /></a>}
      {archiveHref && <a class="text-link featured-project__archive-link" href={archiveHref}>See on all projects <Icon name="arrow" size={16} /></a>}
    </div>}
  </div>
</article>
