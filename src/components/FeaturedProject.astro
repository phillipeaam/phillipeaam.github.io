---
import { caseStudyPath } from '../data/caseStudyRoutes';
import MediaPoster from './MediaPoster.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import { hasPublishableCaseStudy, isPortfolioIncluded, type ProjectRecord } from '../data/projects';
const { project } = Astro.props as { project: ProjectRecord };
const [leadMedia] = project.media ?? [];
const homePath = import.meta.env.BASE_URL;
const caseHref = isPortfolioIncluded(project) && hasPublishableCaseStudy(project) ? caseStudyPath(project.caseStudy.slug, homePath) : undefined;
const archiveHref = isPortfolioIncluded(project) && project.archiveCategory ? `${homePath}projects/#${project.anchorId ?? project.id}` : undefined;
const projectHref = caseHref ?? archiveHref;
const titleIcon = project.catalogIconReuseApproved ? project.projectsIndexTitleIcon : undefined;
const src = leadMedia?.type === 'image' ? leadMedia.src : undefined;
const previewSrc = leadMedia?.type === 'image' ? leadMedia.previewSrc : undefined;
---
<article class="featured-grid-card" data-kind={project.kind}>
  <div class="featured-grid-card__media">
    {src
      ? <ProjectMediaPreview src={src} previewSrc={previewSrc} alt={leadMedia?.alt ?? `${project.name} gameplay`} previewAlt={leadMedia?.previewAlt ?? `${project.name} animated gameplay preview`} posterWidth={leadMedia?.posterWidth} posterHeight={leadMedia?.posterHeight} posterFit={leadMedia?.posterFit} autoplayPreview={leadMedia?.autoplayPreview} linkHref={projectHref} linkLabel={projectHref ? `View ${project.name} project` : undefined} linkClass="featured-grid-card__media-link" />
      : projectHref
        ? <a class="featured-grid-card__media-link" href={projectHref} aria-label={`View ${project.name} project`}><MediaPoster label={project.evidenceLabel ?? project.name} kind={project.kind ?? 'neutral'} /></a>
        : <MediaPoster label={project.evidenceLabel ?? project.name} kind={project.kind ?? 'neutral'} />}
  </div>
  <div class="featured-grid-card__body">
    {projectHref
      ? <a class="featured-grid-card__identity" href={projectHref}>
          {titleIcon && <img class="featured-grid-card__icon" src={titleIcon} alt="" width="52" height="52" loading="lazy" decoding="async" />}
          <div class="featured-grid-card__title">
            {caseHref && <span class="featured-grid-card__case-link">Case study</span>}
            <h3>{project.name}</h3>
          </div>
        </a>
      : <div class="featured-grid-card__identity">
          {titleIcon && <img class="featured-grid-card__icon" src={titleIcon} alt="" width="52" height="52" loading="lazy" decoding="async" />}
          <div class="featured-grid-card__title">
            <h3>{project.name}</h3>
          </div>
        </div>}
    {project.featuredPromo && <p class="featured-grid-card__promo">{project.featuredPromo}</p>}
  </div>
</article>
