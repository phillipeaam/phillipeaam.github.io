---
import MediaPoster from './MediaPoster.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import Icon from './Icon.astro';
const { project, index = 1, reverse = false } = Astro.props;
const [leadMedia] = project.media ?? [];
---
<article class:list={['featured-project', reverse && 'is-reversed']} data-kind={project.kind}>
  <a class="featured-project__media-link" href={`/work/${project.slug}/`} aria-label={`Open ${project.name} case study`}>
    {leadMedia?.type === 'image' && leadMedia.previewSrc
      ? <ProjectMediaPreview posterSrc={leadMedia.src} previewSrc={leadMedia.previewSrc} alt={leadMedia.alt} previewAlt={leadMedia.previewAlt} autoplayPreview={leadMedia.autoplayPreview} posterWidth={leadMedia.posterWidth} posterHeight={leadMedia.posterHeight} posterFit={leadMedia.posterFit} />
      : <MediaPoster label={project.evidenceLabel} kind={project.kind} />}
  </a>
  <div class="featured-copy">
    <h3><a href={`/work/${project.slug}/`}>{project.name}</a></h3>
    <p class="project-product">{project.product}</p>
    <p class="project-contribution">{project.contribution}</p>
    <div class="featured-project__actions">
      <a class="text-link" href={`/work/${project.slug}/`}>Explore case study <Icon name="arrow" size={16} /></a>
      {project.archiveAnchor && <a class="text-link featured-project__archive-link" href={`/projects/#${project.archiveAnchor}`}>See on all projects <Icon name="arrow" size={16} /></a>}
    </div>
  </div>
</article>
