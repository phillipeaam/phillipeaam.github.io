---
import type { ProjectMedia } from '../data/projects';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
const { media, projectName, hideControls = false } = Astro.props as { media: ProjectMedia; projectName: string; hideControls?: boolean };
---
<div class="archive-media">
  {media.type === 'image' && <ProjectMediaPreview posterSrc={media.src} previewSrc={media.previewSrc} alt={media.alt ?? `${projectName} visual evidence`} previewAlt={media.previewAlt} caption={media.caption} autoplayPreview={media.autoplayPreview} posterWidth={media.posterWidth} posterHeight={media.posterHeight} posterFit={media.posterFit} hideControls={hideControls} showControls={Boolean(media.previewSrc)} />}
  {media.type === 'gif' && media.posterSrc && <ProjectMediaPreview posterSrc={media.posterSrc} previewSrc={media.src} alt={media.alt ?? `${projectName} visual evidence`} previewAlt={media.previewAlt} caption={media.caption} autoplayPreview={media.autoplayPreview} posterWidth={media.posterWidth} posterHeight={media.posterHeight} posterFit={media.posterFit} hideControls={hideControls} showControls />}
  {media.type === 'video' && <figure><video controls preload="none" aria-label={media.title ?? `${projectName} video evidence`}><source src={media.src} /></video>{media.caption && <figcaption>{media.caption}</figcaption>}</figure>}
  {media.type === 'youtube' && <figure><iframe src={media.src} title={media.title ?? `${projectName} video evidence`} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>{media.caption && <figcaption>{media.caption}</figcaption>}</figure>}
</div>
