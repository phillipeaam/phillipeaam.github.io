---
import PreviewControl from './PreviewControl.astro';
const { label, alt = label, kind = 'neutral', caption, demoPreview = false, compact = false, posterLabel } = Astro.props;
const kindClass = `proxy-${kind}`;
const posterLabels: Record<string, string> = {
  ilhas: 'GAMEPLAY POSTER — ILHAS',
  wallace: 'TACTICAL GAMEPLAY — WALLACE',
  ello: 'MOBILE PRODUCT UI — ELLO',
  pathless: 'RESCUE GAMEPLAY — PATHLESS',
  craque: 'ASSESSMENT UI — CRAQUE',
  neutral: 'SYSTEM EVIDENCE',
};
---
<figure class:list={['media-figure', compact && 'media-compact']}>
  <div class:list={['media-poster', kindClass]} role="group" aria-label={alt} data-media-poster data-state="poster" data-demo-preview={demoPreview ? 'true' : 'false'}>
    <div class="proxy-scene" aria-hidden="true">
      {kind === 'wallace' && <div class="proxy-grid"><i></i><i></i><i></i></div>}
      {kind === 'ilhas' && <div class="proxy-minigame"><i></i><i></i><i></i></div>}
      {kind === 'ello' && <div class="proxy-phone"><i></i><i></i><i></i></div>}
      {kind === 'craque' && <div class="proxy-assessment"><i></i><i></i><i></i><i></i><i></i></div>}
      {kind === 'pathless' && <div class="proxy-rescue"><i></i><i></i><i></i></div>}
      {kind === 'neutral' && <div class="proxy-flow"><i></i><i></i><i></i></div>}
    </div>
    <span class="poster-overline">{posterLabel ?? posterLabels[kind] ?? label}</span>
    {demoPreview && <div class="preview-message" aria-hidden="true"><span class="preview-indicator"></span><span>PREVIEW STATE · PLACEHOLDER ONLY</span></div>}
  </div>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
  {demoPreview && <PreviewControl accessibleLabel={`Play preview state for ${label}`} />}
</figure>
{demoPreview && <script>
  const previewControls = [...document.querySelectorAll<HTMLButtonElement>('[data-preview-control]:not([data-bound])')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const setPreviewState = (button: HTMLButtonElement, playing: boolean) => {
    const poster = button.closest('.media-figure')?.querySelector<HTMLElement>('[data-media-poster]');
    if (!poster) return;
    poster.dataset.state = playing ? 'playing' : 'poster';
    button.setAttribute('aria-pressed', String(playing));
    const project = poster.querySelector('.poster-overline')?.textContent ?? 'project';
    button.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} preview state for ${project}`);
    const label = button.querySelector<HTMLElement>('[data-control-label]');
    const icon = button.querySelector<HTMLElement>('[data-control-icon]');
    if (label) label.textContent = playing ? 'Pause preview state' : 'Preview';
    if (icon) icon.textContent = playing ? 'Ⅱ' : '▶';
    poster.querySelector('.preview-message')?.setAttribute('aria-hidden', String(!playing));
  };
  const syncMotionPreference = () => {
    for (const button of previewControls) {
      button.disabled = reducedMotion.matches;
      if (reducedMotion.matches) {
        setPreviewState(button, false);
        button.setAttribute('aria-label', 'Preview unavailable while reduced motion is enabled');
      } else {
        button.setAttribute('aria-label', `Play preview state for ${button.closest('.media-figure')?.querySelector('.poster-overline')?.textContent ?? 'project'}`);
      }
    }
  };
  document.addEventListener('portfolio-preview-start', (event) => {
    const active = (event as CustomEvent<HTMLButtonElement>).detail;
    for (const button of previewControls) if (button !== active) setPreviewState(button, false);
  });
  for (const button of previewControls) {
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      if (reducedMotion.matches) return;
      const poster = button.closest('.media-figure')?.querySelector<HTMLElement>('[data-media-poster]');
      const playing = poster?.dataset.state !== 'playing';
      if (playing) document.dispatchEvent(new CustomEvent('portfolio-preview-start', { detail: button }));
      setPreviewState(button, playing);
    });
  }
  syncMotionPreference();
  reducedMotion.addEventListener('change', syncMotionPreference);
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) {
          const button = entry.target.closest('.media-figure')?.querySelector<HTMLButtonElement>('[data-preview-control]');
          if (button) setPreviewState(button, false);
        }
      }
    }, { threshold: 0.05 });
    document.querySelectorAll<HTMLElement>('[data-media-poster][data-demo-preview="true"]').forEach((poster) => observer.observe(poster));
  }
</script>}
