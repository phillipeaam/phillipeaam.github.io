---
import { getProjectRecord, isPortfolioIncluded, type ProjectRecord } from '../data/projects';
import SupportingProject from './SupportingProject.astro';
const projects = ['tabuada-na-fazenda', 'craque-da-leitura', 'flui']
  .map((id) => getProjectRecord(id))
  .filter((project): project is ProjectRecord => project !== undefined && isPortfolioIncluded(project));
---
<div class="supporting-grid">
  {projects.map((project, index) => <SupportingProject project={project} number={`0${index + 1}`} />)}
</div>
