---
import MediaPoster from './MediaPoster.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import ExternalLink from './ExternalLink.astro';
import { isPortfolioIncluded, type ProjectRecord } from '../data/projects';
const { project, number, recent = false, simple = false, showMeta = true, showContext = true } = Astro.props as { project: ProjectRecord; number?: string | number; recent?: boolean; simple?: boolean; showMeta?: boolean; showContext?: boolean };
const primaryMedia = project.media?.find((item) => item.type === 'image');
const archiveHref = simple && isPortfolioIncluded(project) && project.archiveCategory ? `${import.meta.env.BASE_URL}projects/#${project.anchorId ?? project.id}` : undefined;
---
<article class:list={['supporting-card', recent && 'supporting-card--recent']} id={`work-${project.id}`}>
  {archiveHref && (simple && primaryMedia
    ? <ProjectMediaPreview posterSrc={primaryMedia.src} previewSrc={primaryMedia.previewSrc} alt={primaryMedia.alt ?? `${project.name} project poster`} previewAlt={primaryMedia.previewAlt} posterWidth={primaryMedia.posterWidth} posterHeight={primaryMedia.posterHeight} posterFit={primaryMedia.posterFit} autoplayPreview={primaryMedia.autoplayPreview} linkHref={archiveHref} linkLabel={`View ${project.name} project details`} linkClass="supporting-card-media-link" />
    : <a class="supporting-card-media-link" href={archiveHref} aria-label={`View ${project.name} project details`}><MediaPoster label={`${project.name} media placeholder`} posterLabel={project.evidenceLabel} posterSrc={primaryMedia?.src} previewSrc={primaryMedia?.previewSrc} kind={project.kind ?? 'neutral'} compact /></a>)}
  {!archiveHref && (simple && primaryMedia
    ? <ProjectMediaPreview posterSrc={primaryMedia.src} previewSrc={primaryMedia.previewSrc} alt={primaryMedia.alt ?? `${project.name} project poster`} previewAlt={primaryMedia.previewAlt} posterWidth={primaryMedia.posterWidth} posterHeight={primaryMedia.posterHeight} posterFit={primaryMedia.posterFit} autoplayPreview={primaryMedia.autoplayPreview} />
    : <MediaPoster label={`${project.name} media placeholder`} posterLabel={project.evidenceLabel} posterSrc={primaryMedia?.src} previewSrc={primaryMedia?.previewSrc} kind={project.kind ?? 'neutral'} compact />)}
  <div class:list={['supporting-card-copy', simple && 'supporting-card-copy--simple']}>
    {simple ? <>
      <h3 class="sr-only">{project.name}</h3>
    </> : <>
    {showMeta && (number || project.period || project.type) && <p class="supporting-card-meta">{(number || project.period) && <span>{number}{project.period && ` / ${project.period}`}</span>}{project.type && <span>{project.type}</span>}</p>}
    <h3>{project.name}</h3>
    <p class="supporting-card-detail">{project.summary}</p>
    {project.contribution && <p class="supporting-card-contribution"><span>My contribution</span>{project.contribution}</p>}
    {showContext && project.context && <p class="supporting-card-context">{project.context}</p>}
    {isPortfolioIncluded(project) && project.actions?.length && <div class="project-actions" aria-label={`${project.name} links`}>
      {project.actions.slice(0, 2).map((action) => <ExternalLink class="supporting-card-link" href={action.href} icon>{action.label}</ExternalLink>)}
    </div>}
    </>}
  </div>
</article>
