---
import MediaPoster from './MediaPoster.astro';
import ProjectMediaPreview from './ProjectMediaPreview.astro';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
const { id, anchorId, number, period, name, type, detail, product = detail, contribution, context, mediaLabel, posterSrc, previewSrc, href, linkLabel = 'View product', actions, kind = 'neutral', recent = false, simple = false, showMeta = true, showContext = true } = Astro.props;
const projectActions = actions ?? (href ? [{ href, label: linkLabel }] : []);
const archiveHref = simple && id ? `${import.meta.env.BASE_URL}projects/#${anchorId ?? id}` : undefined;
---
<article class:list={['supporting-card', recent && 'supporting-card--recent']} id={anchorId ?? (id && `work-${id}`)}>
  {archiveHref && <a class="supporting-card-media-link" href={archiveHref} aria-label={`View ${name} project details`}>
    {simple && id === 'pathless'
      ? <ProjectMediaPreview posterSrc="/projects/pathless/pathless-poster.png" previewSrc="/projects/pathless/pathless-gameplay-preview.gif" alt="Pathless gameplay poster showing a helicopter above a rescue-game landscape." />
      : <MediaPoster label={`${name} media placeholder`} posterLabel={mediaLabel} posterSrc={posterSrc} previewSrc={previewSrc} kind={kind} compact />}
  </a>}
  {!archiveHref && (simple && id === 'pathless'
    ? <ProjectMediaPreview posterSrc="/projects/pathless/pathless-poster.png" previewSrc="/projects/pathless/pathless-gameplay-preview.gif" alt="Pathless gameplay poster showing a helicopter above a rescue-game landscape." />
    : <MediaPoster label={`${name} media placeholder`} posterLabel={mediaLabel} posterSrc={posterSrc} previewSrc={previewSrc} kind={kind} compact />)}
  <div class:list={['supporting-card-copy', simple && 'supporting-card-copy--simple']}>
    {simple ? <>
      <h3>{name}</h3>
      {archiveHref && <div class="project-actions" aria-label={`${name} links`}>
        <a class="supporting-card-link" href={archiveHref} aria-label={`Details for ${name}`}><span>Details</span><Icon name="external" size={15} /></a>
      </div>}
    </> : <>
    {showMeta && (number || period || type) && <p class="supporting-card-meta"><span>{number}{period && ` / ${period}`}</span><span>{type}</span></p>}
    <h3>{name}</h3>
    <p class="supporting-card-detail">{product}</p>
    {contribution && <p class="supporting-card-contribution"><span>My contribution</span>{contribution}</p>}
    {showContext && context && <p class="supporting-card-context">{context}</p>}
    {actions && projectActions.length > 0 && <div class="project-actions" aria-label={`${name} links`}>
      {projectActions.slice(0, 2).map((action: { href: string; label: string }) => <ExternalLink class="supporting-card-link" href={action.href} icon>{action.label}</ExternalLink>)}
    </div>}
    {!actions && href && <ExternalLink class="supporting-card-link" href={href} icon>{linkLabel}</ExternalLink>}
    </>}
  </div>
</article>
