---
import MediaPoster from './MediaPoster.astro';
import Icon from './Icon.astro';
const { id, number, period, name, type, detail, context, tags = [], mediaLabel, posterSrc, previewSrc, href, linkLabel = 'View product', kind = 'neutral', recent = false, showMeta = true } = Astro.props;
---
<article class:list={['supporting-card', recent && 'supporting-card--recent']} id={id}>
  <MediaPoster label={`${name} media placeholder`} posterLabel={mediaLabel} posterSrc={posterSrc} previewSrc={previewSrc} kind={kind} compact />
  <div class="supporting-card-copy">
    {showMeta && (number || period || type) && <p class="supporting-card-meta"><span>{number}{period && ` / ${period}`}</span><span>{type}</span></p>}
    <h3>{name}</h3>
    <p class="supporting-card-detail">{detail}</p>
    {context && <p class="supporting-card-context">{context}</p>}
    {tags.length > 0 && <ul class="supporting-card-tags" aria-label={`${name} technologies and context`}>{tags.map((tag: string) => <li>{tag}</li>)}</ul>}
    {href && <a class="supporting-card-link" href={href}>{linkLabel} <Icon name="external" size={15} /></a>}
  </div>
</article>
